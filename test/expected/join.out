CREATE TABLE jk2 AS SELECT k FROM (VALUES (5), (15005)) AS v(k);
CREATE TABLE jk19 AS SELECT k FROM (VALUES (1), (9)) AS v(k);
CREATE TABLE jkw AS SELECT g AS k FROM generate_series(20001, 30000) AS g;
