       join_pruned($$SELECT count(*) FROM jpr JOIN jkwide ON jpr.k = jkwide.k WHERE jkwide.k > 20000$$) AS clause,
       join_pruned($$SELECT count(*) FROM jp2 JOIN jkx2 ON jp2.k = jkx2.k2$$) AS second_level;
