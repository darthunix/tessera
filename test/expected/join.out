-- A generic plan executed again with another parameter.
SET plan_cache_mode = force_generic_plan;
PREPARE joined(int) AS SELECT count(*), sum(jdup.w) FROM jf JOIN jdup ON jf.fk = jdup.k WHERE jf.v > $1;
EXECUTE joined(100);
