-- An inner side the planner thinks small: the table goes past hash_mem
-- and spills; at a hash_mem this small the tails of its partitions do
-- not fit either, and the memory goes over it.
CREATE FUNCTION join_many() RETURNS SETOF int LANGUAGE sql ROWS 10
AS 'SELECT generate_series(1, 20000)';
SET work_mem = '64kB';
SELECT join_explain($$SELECT count(*) FROM jf JOIN join_many() AS m(k) ON jf.v = m.k$$);
                                     join_explain                                     
--------------------------------------------------------------------------------------
 Custom Scan (TessAgg) (actual rows=1.00 loops=1)
   Input Batches: 21
   Input Rows: 1000
   Kernel Calls: 21
   ->  Custom Scan (TessHashJoin) (actual rows=1000.00 loops=1)
         Hash Cond: (jf.v = m.k)
         Buckets: 1024
         Memory Usage: within hash_mem
         Batches: 4
         Disk Usage: 253 kB
         Rows Removed by Bloom Filter: 0
         Builds: 1
         Build Rows: 20000
         Chunks: 47
         Resident Partitions: 0
         Spilled Chunks: 200
         Tail Chunks Kept: 0
         Split Partitions: 4
         Probe Rows: 1000
         Matches: 1000
         Bloom Filters: 1
         ->  Custom Scan (TessHeapScan) on public.jf (actual rows=1000.00 loops=1)
               Batch Size: 64
               Batches: 18
               Pages: 9
               Deformed Datums: 1000
               Restarted Datums: 0
         ->  Custom Scan (TessPack) (actual rows=20000.00 loops=1)
               Batch Size: 64
               Rows Kept As: copies
               Batches: 313
               ->  Function Scan on public.join_many m (actual rows=20000.00 loops=1)
                     Function Call: join_many()
(33 rows)

