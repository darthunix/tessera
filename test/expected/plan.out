\getenv libdir PG_LIBDIR
\getenv dlsuffix PG_DLSUFFIX
\set plan_test :libdir '/tessera_plan_test' :dlsuffix
LOAD :'plan_test';
CREATE FUNCTION tessera_test_plan_roundtrip()
RETURNS boolean
AS :'plan_test', 'tessera_test_plan_roundtrip'
LANGUAGE C STRICT;
CREATE FUNCTION tessera_test_plan_errors(integer)
RETURNS void
AS :'plan_test', 'tessera_test_plan_errors'
LANGUAGE C STRICT;
SELECT tessera_test_plan_roundtrip() AS roundtrip \gset
\echo :roundtrip
t
\set VERBOSITY terse
SELECT tessera_test_plan_errors(0);
ERROR:  Tessera plan writer requires a kind and version
SELECT tessera_test_plan_errors(1);
ERROR:  Tessera plan field "count" is duplicated
SELECT tessera_test_plan_errors(2);
ERROR:  Tessera plan string field "name" is NULL
SELECT tessera_test_plan_errors(3);
ERROR:  Tessera plan writer is not active
SELECT tessera_test_plan_errors(4);
ERROR:  Tessera plan field requires a name
SELECT tessera_test_plan_errors(5);
ERROR:  Tessera plan field "items" is not a List
SELECT tessera_test_plan_errors(6);
ERROR:  Tessera plan field "ints" is not an IntList
SELECT tessera_test_plan_errors(7);
ERROR:  Tessera expected other.record plan data, got test.record
SELECT tessera_test_plan_errors(8);
ERROR:  Tessera expected test.record plan version 4, got 3
SELECT tessera_test_plan_errors(9);
ERROR:  Tessera received malformed test.record plan data
SELECT tessera_test_plan_errors(10);
ERROR:  Tessera received malformed test.record plan field
SELECT tessera_test_plan_errors(11);
ERROR:  Tessera test.record plan field "a" is duplicated
SELECT tessera_test_plan_errors(12);
ERROR:  Tessera test.record plan field "count" was read twice
SELECT tessera_test_plan_errors(13);
ERROR:  Tessera test.record plan field "absent" is missing
SELECT tessera_test_plan_errors(14);
ERROR:  Tessera test.record plan field "name" is not an integer
SELECT tessera_test_plan_errors(15);
ERROR:  Tessera test.record plan field "count" is not a string
SELECT tessera_test_plan_errors(16);
ERROR:  Tessera test.record plan field "count" is not a List
SELECT tessera_test_plan_errors(17);
ERROR:  Tessera test.record plan field "items" is not an IntList
SELECT tessera_test_plan_errors(18);
ERROR:  Tessera test.record plan field "n" is not an integer
SELECT tessera_test_plan_errors(19);
ERROR:  Tessera test.record plan field "name" was not read
\set VERBOSITY default
DROP FUNCTION tessera_test_plan_errors(integer);
DROP FUNCTION tessera_test_plan_roundtrip();
