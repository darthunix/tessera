   ->  Custom Scan (TessFilter) on index_t
         Batch Filter: ((k < 300) OR (w = 5))
         ->  Custom Scan (TessHeapScan) on index_t
               ->  BitmapOr
                     ->  Bitmap Index Scan on index_t_k
                           Index Cond: (k < 300)
                     ->  Bitmap Index Scan on index_t_w
                           Index Cond: (w = 5)
(9 rows)

SELECT index_same($$SELECT count(*), sum(id) FROM index_t WHERE k < 300 OR w = 5$$);
 index_same 
