(1 row)

FETCH BACKWARD ALL FROM agg_cursor;
 count 
-------
   172
(1 row)

COMMIT;
-- Under a single-copy Gather.
SET debug_parallel_query = on;
EXPLAIN (COSTS OFF) SELECT count(*) FROM agg_t WHERE a > 100;
                      QUERY PLAN                       
-------------------------------------------------------
 Gather
   Workers Planned: 1
   Single Copy: true
   ->  Custom Scan (TessAgg)
         ->  Custom Scan (TessFilter) on agg_t
               Batch Filter: (a > 100)
               ->  Custom Scan (TessHeapScan) on agg_t
(7 rows)

SELECT count(*) FROM agg_t WHERE a > 100;
 count 
-------
