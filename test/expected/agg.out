   ->  Custom Scan (TessPack)
         Rows Kept As: forwarded batches
         ->  Custom Scan (TessLimit)
               ->  Custom Scan (TessFilter) on agg_t
                     Batch Filter: (agg_t.a > 100)
                     ->  Custom Scan (TessHeapScan) on agg_t
(7 rows)

