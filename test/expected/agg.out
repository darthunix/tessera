EXPLAIN (COSTS OFF) SELECT sum(a) FROM agg8_t WHERE a > 100;
                    QUERY PLAN                    
--------------------------------------------------
 Aggregate
   ->  Custom Scan (TessFilter) on agg8_t
         Batch Filter: (a > 100)
         ->  Custom Scan (TessHeapScan) on agg8_t
(4 rows)

DROP TABLE agg8_t;
-- Pages and batches: wide rows make the scan pin many pages.
CREATE TABLE agg_wide AS
SELECT i AS a, repeat('x', 500) AS pad FROM generate_series(1, 1000) AS i;
SELECT agg_same($$SELECT count(*) FROM agg_wide WHERE a % 3 = 0$$);
 agg_same 
----------
 {(333)}
(1 row)

EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF)
SELECT count(*) FROM agg_wide WHERE a % 3 = 0;
                                    QUERY PLAN                                    
----------------------------------------------------------------------------------
 Custom Scan (TessAgg) (actual rows=1.00 loops=1)
   Input Batches: 67
   Input Rows: 333
   Kernel Calls: 67
   ->  Custom Scan (TessFilter) on agg_wide (actual rows=333.00 loops=1)
         Batch Filter: ((a % 3) = 0)
         Rows Removed by Batch Filter: 667
         Input Batches: 67
         Input Rows: 1000
         Output Rows: 333
         ->  Custom Scan (TessHeapScan) on agg_wide (actual rows=1000.00 loops=1)
               Batch Size: 64
               Batches: 67
               Pages: 67
               Deformed Datums: 1000
               Restarted Datums: 0
(16 rows)

-- Few survivors per batch are gathered into one call per 64: 333 rows over
-- 67 batches make six calls of the sum, the last over the 13 left.
SELECT agg_same($$SELECT sum(a), min(a), max(a), count(a) FROM agg_wide WHERE a % 3 = 0$$);
        agg_same        
------------------------
 {"(166833,3,999,333)"}
(1 row)

EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF)
SELECT sum(a) FROM agg_wide WHERE a % 3 = 0;
                                    QUERY PLAN                                    
----------------------------------------------------------------------------------
 Custom Scan (TessAgg) (actual rows=1.00 loops=1)
   Input Batches: 67
   Input Rows: 333
   Kernel Calls: 6
   Computed Datums: 333
   ->  Custom Scan (TessFilter) on agg_wide (actual rows=333.00 loops=1)
         Batch Filter: ((a % 3) = 0)
         Rows Removed by Batch Filter: 667
         Input Batches: 67
         Input Rows: 1000
         Output Rows: 333
         ->  Custom Scan (TessHeapScan) on agg_wide (actual rows=1000.00 loops=1)
               Batch Size: 64
               Batches: 67
               Pages: 67
               Deformed Datums: 1000
               Restarted Datums: 0
(17 rows)

DROP TABLE agg_wide;
-- A join below: the hash join publishes batches, no pack between.
EXPLAIN (COSTS OFF)
SELECT count(*) FROM agg_t AS x JOIN agg_t AS y ON x.b = y.b WHERE x.a > 295;
                       QUERY PLAN                        
---------------------------------------------------------
 Custom Scan (TessAgg)
   ->  Custom Scan (TessHashJoin)
         ->  Custom Scan (TessHeapScan) on agg_t y
         ->  Custom Scan (TessFilter) on agg_t x
               Batch Filter: (x.a > 295)
               ->  Custom Scan (TessHeapScan) on agg_t x
(6 rows)

SELECT agg_same($$SELECT count(*) FROM agg_t AS x JOIN agg_t AS y ON x.b = y.b WHERE x.a > 295$$);
 agg_same 
----------
 {(150)}
(1 row)

