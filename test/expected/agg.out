-- A scrollable cursor gets a Material above the node.
BEGIN;
DECLARE agg_cursor SCROLL CURSOR FOR SELECT count(*) FROM agg_t WHERE a > 100;
FETCH ALL FROM agg_cursor;
 count 
-------
