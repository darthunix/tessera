 {"(0,-125000.00,-0.62500000000000000000,100000500000000,500002.500000000000)","(1,-217000.00,-1.0850000000000000,99999700000000,499998.500000000000)","(2,-159000.00,-0.79500000000000000000,99999900000000,499999.500000000000)","(3,-161000.00,-0.80500000000000000000,100000100000000,500000.500000000000)","(4,-223000.00,-1.1150000000000000,100000300000000,500001.500000000000)"}
(1 row)

