-- Left to the core: grouping sets, a text key, a column the primary key
-- makes functionally dependent, and hash aggregation disabled.
EXPLAIN (COSTS OFF) SELECT b, count(*) FROM agg_t GROUP BY GROUPING SETS ((b), ());
