SET enable_mergejoin = off;
SET enable_nestloop = off;
EXPLAIN (COSTS OFF) SELECT f.a, o.x FROM ft_t AS f JOIN outer_rows AS o ON f.a = o.x;
                    QUERY PLAN                    
--------------------------------------------------
 Custom Scan (TessHashJoin)
   Hash Cond: (f.a = o.x)
   ->  Custom Scan (TessTestSource) on ft_t f
         Foreign Path: first
   ->  Custom Scan (TessHeapScan) on outer_rows o
(5 rows)

SELECT source_same('SELECT f.a, o.x FROM ft_t AS f JOIN outer_rows AS o ON f.a = o.x');
  source_same  
