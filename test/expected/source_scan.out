EXPLAIN (COSTS OFF) SELECT b, count(*) FROM ft_t GROUP BY b;
            QUERY PLAN             
-----------------------------------
 Custom Scan (TessAgg)
   Group Key: b
   ->  Custom Scan (TessPack)
         ->  Foreign Scan on ft_t
               Foreign Path: first
(5 rows)

SELECT source_same('SELECT b, count(*) FROM ft_t GROUP BY b');
  source_same  
---------------
 same, 10 rows
(1 row)

