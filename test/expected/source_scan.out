-- spec: source-scan/Answers that are not allowed
-- An exact and a pruning answer for a clause not usable, a value none of
-- the three, an exact and a pruning answer for a clause the path does
-- not carry; under TessFilter, a plan with qualifiers and a plan
-- without a clause it answered for. Beyond the scenario, an internal
-- check: a clause handed to the filter that its path did not record.
SELECT tessera_test_scan_sources(ARRAY['faulty']);
 tessera_test_scan_sources 
---------------------------
 
(1 row)

SELECT fault, source_error('EXPLAIN SELECT count(*) FROM ft_t WHERE counted(b) AND a > 10 AND b < 5')
FROM unnest(ARRAY['unusable', 'unusable_prune', 'bad_value', 'not_carried',
    'not_carried_prune', 'plan_qual', 'plan_missing', 'extra_clause']) AS fault,
    LATERAL tessera_test_scan_source_fault(fault);
       fault       |                                      source_error                                       
-------------------+-----------------------------------------------------------------------------------------
 unusable          | XX000: Tessera source "tessera_test.faulty" used a clause it may not use
 unusable_prune    | XX000: Tessera source "tessera_test.faulty" used a clause it may not use
 bad_value         | XX000: Tessera source "tessera_test.faulty" gave the answer 7 for a clause
 not_carried       | XX000: Tessera source "tessera_test.faulty" did not carry a clause it answered for
 not_carried_prune | XX000: Tessera source "tessera_test.faulty" did not carry a clause it answered for
 plan_qual         | XX000: TessFilter found qualifiers on its source's plan
 plan_missing      | XX000: TessFilter found a clause its source answered for missing from the source's plan
 extra_clause      | XX000: TessFilter found a clause its path did not record
(8 rows)

