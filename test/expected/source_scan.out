-- spec: source-scan/A path refused
-- A core path, a custom path tess_path_create did not build, a batch path
-- of another relation, with parameters, with path keys, without
-- projection, serial for a partial offer, partial for a serial one,
-- partial and not parallel-aware, partial and not parallel-safe, of
-- another number of workers, and serial and parallel-safe where the offer
-- is not.
SELECT tessera_test_scan_sources(ARRAY['faulty']);
 tessera_test_scan_sources 
---------------------------
 
(1 row)

SELECT fault, source_error('EXPLAIN SELECT b, count(*) FROM ft_par GROUP BY b')
FROM unnest(ARRAY['core', 'other_custom', 'other_relation', 'params', 'pathkeys',
    'no_projection', 'serial_for_partial', 'partial_for_serial', 'partial_unaware',
    'partial_unsafe', 'workers']) AS fault,
    LATERAL tessera_test_scan_source_fault(fault);
       fault        |                                       source_error                                       
--------------------+------------------------------------------------------------------------------------------
 core               | XX000: Tessera source "tessera_test.faulty" returned a path of no batch node
 other_custom       | XX000: Tessera source "tessera_test.faulty" returned a path of no batch node
 other_relation     | XX000: Tessera source "tessera_test.faulty" returned a path of another shape
 params             | XX000: Tessera source "tessera_test.faulty" returned a path of another shape
 pathkeys           | XX000: Tessera source "tessera_test.faulty" returned a path of another shape
 no_projection      | XX000: Tessera source "tessera_test.faulty" returned a path of another shape
 serial_for_partial | XX000: Tessera source "tessera_test.faulty" returned a path of other parallel properties
 partial_for_serial | XX000: Tessera source "tessera_test.faulty" returned a path of other parallel properties
 partial_unaware    | XX000: Tessera source "tessera_test.faulty" returned a path of other parallel properties
 partial_unsafe     | XX000: Tessera source "tessera_test.faulty" returned a path of other parallel properties
 workers            | XX000: Tessera source "tessera_test.faulty" returned a path of other parallel properties
(11 rows)

SET max_parallel_workers_per_gather = 0;
SELECT tessera_test_scan_source_fault('serial_safe');
 tessera_test_scan_source_fault 
--------------------------------
 
(1 row)

