                                       source_error                                       
------------------------------------------------------------------------------------------
 XX000: Tessera source "tessera_test.faulty" returned a path of other parallel properties
(1 row)

RESET max_parallel_workers_per_gather;
SELECT tessera_test_scan_source_fault(NULL);
 tessera_test_scan_source_fault 
--------------------------------
 
(1 row)

RESET parallel_setup_cost;
RESET parallel_tuple_cost;
