CREATE EXTENSION tessera;
LOAD 'tessera_nodes';
\getenv libdir PG_LIBDIR
\getenv dlsuffix PG_DLSUFFIX
\set pack_test :libdir '/tessera_pack_test' :dlsuffix
LOAD :'pack_test';
CREATE FUNCTION tessera_test_pack_paths()
RETURNS boolean
AS :'pack_test', 'tessera_test_pack_paths'
LANGUAGE C STRICT;
SELECT tessera_test_pack_paths() AS paths \gset
\echo :paths
t
-- The sink, a stand-in for a batch-aware parent, wraps the scan of every
-- pack_* table in the pack node and returns the rows of the batches.
CREATE TABLE pack_t (a int, b text);
INSERT INTO pack_t
SELECT i, CASE WHEN i % 10 = 0 THEN NULL ELSE 'row' || i END
FROM generate_series(1, 100) AS i;
CREATE TABLE pack_empty (a int);
EXPLAIN (COSTS OFF) SELECT a, b FROM pack_t WHERE a > 90;
           QUERY PLAN            
---------------------------------
 Custom Scan (tessera_pack_sink)
   Role: sink
   Requested Rows: 0
   ->  Custom Scan (TessPack)
         ->  Seq Scan on pack_t
               Filter: (a > 90)
(6 rows)

SELECT a, b FROM pack_t WHERE a > 90;
  a  |   b   
-----+-------
  91 | row91
  92 | row92
  93 | row93
  94 | row94
  95 | row95
  96 | row96
  97 | row97
  98 | row98
  99 | row99
 100 | 
(10 rows)

SELECT count(*), sum(a), count(b) FROM pack_t;
 count | sum  | count 
-------+------+-------
   100 | 5050 |    90
(1 row)

-- Batches follow the parent's request, at most 64 rows each.
EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF)
SELECT a FROM pack_t;
                          QUERY PLAN                          
--------------------------------------------------------------
 Custom Scan (tessera_pack_sink) (actual rows=100.00 loops=1)
   Role: sink
   Requested Rows: 0
   Input Batches: 2
   Input Rows: 100
   Output Rows: 100
   Child Request: filter {} projection {0} max 0
   ->  Custom Scan (TessPack) (actual rows=100.00 loops=1)
         Batch Size: 64
         Rows Kept As: heap tuples
         Batches: 2
         Deformed Datums: 100
         Restarted Datums: 0
         ->  Seq Scan on pack_t (actual rows=100.00 loops=1)
(14 rows)

SET pack_test.batch_rows = 10;
EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF)
SELECT a FROM pack_t;
                          QUERY PLAN                          
--------------------------------------------------------------
 Custom Scan (tessera_pack_sink) (actual rows=100.00 loops=1)
   Role: sink
   Requested Rows: 10
   Input Batches: 10
   Input Rows: 100
   Output Rows: 100
   Child Request: filter {} projection {0} max 10
   ->  Custom Scan (TessPack) (actual rows=100.00 loops=1)
         Batch Size: 10
         Rows Kept As: heap tuples
         Batches: 10
         Deformed Datums: 100
         Restarted Datums: 0
         ->  Seq Scan on pack_t (actual rows=100.00 loops=1)
(14 rows)

SET pack_test.batch_rows = 200;
EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF)
SELECT a FROM pack_t;
                          QUERY PLAN                          
--------------------------------------------------------------
 Custom Scan (tessera_pack_sink) (actual rows=100.00 loops=1)
   Role: sink
   Requested Rows: 200
   Input Batches: 2
   Input Rows: 100
   Output Rows: 100
   Child Request: filter {} projection {0} max 200
   ->  Custom Scan (TessPack) (actual rows=100.00 loops=1)
         Batch Size: 64
         Rows Kept As: heap tuples
         Batches: 2
         Deformed Datums: 100
         Restarted Datums: 0
         ->  Seq Scan on pack_t (actual rows=100.00 loops=1)
(14 rows)

SET pack_test.batch_rows = 7;
SELECT count(*), sum(a) FROM pack_t;
 count | sum  
-------+------
   100 | 5050
(1 row)

RESET pack_test.batch_rows;
-- An empty child publishes nothing.
EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF)
SELECT a FROM pack_empty;
                          QUERY PLAN                           
---------------------------------------------------------------
 Custom Scan (tessera_pack_sink) (actual rows=0.00 loops=1)
   Role: sink
   Requested Rows: 0
   Input Batches: 0
   Input Rows: 0
   Output Rows: 0
   Child Request: filter {} projection {0} max 0
   ->  Custom Scan (TessPack) (actual rows=0.00 loops=1)
         Batch Size: 64
         Batches: 0
         ->  Seq Scan on pack_empty (actual rows=0.00 loops=1)
(11 rows)

-- A limit above stops after the first batch.
EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF)
SELECT a FROM pack_t LIMIT 3;
                            QUERY PLAN                            
------------------------------------------------------------------
 Limit (actual rows=3.00 loops=1)
   ->  Custom Scan (tessera_pack_sink) (actual rows=3.00 loops=1)
         Role: sink
         Requested Rows: 0
         Input Batches: 1
         Input Rows: 64
         Output Rows: 64
         Child Request: filter {} projection {0} max 0
         ->  Custom Scan (TessPack) (actual rows=64.00 loops=1)
               Batch Size: 64
               Rows Kept As: heap tuples
               Batches: 1
               Deformed Datums: 64
               Restarted Datums: 0
               ->  Seq Scan on pack_t (actual rows=64.00 loops=1)
(15 rows)

SELECT a FROM pack_t LIMIT 3;
 a 
---
 1
 2
 3
(3 rows)

-- Rescan: a correlated subplan runs the node once per outer row.
EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF)
SELECT g, (SELECT count(*) FROM pack_t AS p WHERE p.a <= g) AS n
FROM generate_series(1, 3) AS g;
                                QUERY PLAN                                 
---------------------------------------------------------------------------
 Function Scan on generate_series g (actual rows=3.00 loops=1)
   SubPlan expr_1
     ->  Aggregate (actual rows=1.00 loops=3)
           ->  Custom Scan (tessera_pack_sink) (actual rows=2.00 loops=3)
                 Role: sink
                 Requested Rows: 0
                 Input Batches: 3
                 Input Rows: 6
                 Output Rows: 6
                 Child Request: filter {} projection {} max 0
                 ->  Custom Scan (TessPack) (actual rows=2.00 loops=3)
                       Batch Size: 64
                       Rows Kept As: heap tuples
                       Batches: 3
                       Deformed Datums: 0
                       Restarted Datums: 0
                       ->  Seq Scan on pack_t p (actual rows=2.00 loops=3)
                             Filter: (a <= g.g)
                             Rows Removed by Filter: 98
(19 rows)

SELECT g, (SELECT count(*) FROM pack_t AS p WHERE p.a <= g) AS n
FROM generate_series(1, 3) AS g;
 g | n 
---+---
 1 | 1
 2 | 2
 3 | 3
(3 rows)

-- A scrollable cursor: the planner adds Material, the node never scans
-- backward.
BEGIN;
DECLARE c SCROLL CURSOR FOR SELECT a FROM pack_t;
FETCH 2 FROM c;
 a 
---
 1
 2
(2 rows)

FETCH BACKWARD 1 FROM c;
 a 
---
 1
(1 row)

COMMIT;
-- A parallel worker runs the node from the plan's text form.
SET debug_parallel_query = on;
EXPLAIN (COSTS OFF) SELECT a FROM pack_t WHERE a > 98;
              QUERY PLAN               
---------------------------------------
 Gather
   Workers Planned: 1
   Single Copy: true
   ->  Custom Scan (tessera_pack_sink)
         Role: sink
         Requested Rows: 0
         ->  Custom Scan (TessPack)
               ->  Seq Scan on pack_t
                     Filter: (a > 98)
(9 rows)

SELECT count(*), sum(a) FROM pack_t;
 count | sum  
-------+------
   100 | 5050
(1 row)

RESET debug_parallel_query;
SET tessera.enable = off;
EXPLAIN (COSTS OFF) SELECT a FROM pack_t;
     QUERY PLAN     
--------------------
 Seq Scan on pack_t
(1 row)

RESET tessera.enable;
-- A trim node between the sink and the pack node keeps the rows whose
-- first column is at most the setting: the unary helper forwards the
-- merged request and skips a batch left without rows.
SET pack_test.trim = 50;
EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF)
SELECT count(a) FROM pack_t;
                               QUERY PLAN                                
-------------------------------------------------------------------------
 Custom Scan (TessAgg) (actual rows=1.00 loops=1)
   Input Batches: 2
   Input Rows: 50
   Kernel Calls: 0
   Computed Datums: 50
   ->  Custom Scan (tessera_pack_sink) (actual rows=50.00 loops=1)
         Role: sink
         Requested Rows: 0
         Input Batches: 2
         Input Rows: 50
         Output Rows: 50
         Child Request: filter {} projection {0} max 0
         ->  Custom Scan (tessera_pack_sink) (actual rows=50.00 loops=1)
               Role: trim
               Input Batches: 4
               Input Rows: 100
               Output Rows: 50
               Child Request: filter {0} projection {0} max 32
               ->  Custom Scan (TessPack) (actual rows=100.00 loops=1)
                     Batch Size: 32
                     Rows Kept As: heap tuples
                     Batches: 4
                     Deformed Datums: 100
                     Restarted Datums: 0
                     ->  Seq Scan on pack_t (actual rows=100.00 loops=1)
(25 rows)

SELECT count(a), sum(a) FROM pack_t;
 count | sum  
-------+------
    50 | 1275
(1 row)

SELECT a, b FROM pack_t WHERE a > 45;
 a  |   b   
----+-------
 46 | row46
 47 | row47
 48 | row48
 49 | row49
 50 | 
(5 rows)

SET pack_test.trim = 0;
EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF)
SELECT a FROM pack_t;
                            QUERY PLAN                             
-------------------------------------------------------------------
 Custom Scan (tessera_pack_sink) (actual rows=0.00 loops=1)
   Role: sink
   Requested Rows: 0
   Input Batches: 0
   Input Rows: 0
   Output Rows: 0
   Child Request: filter {} projection {0} max 0
   ->  Custom Scan (tessera_pack_sink) (actual rows=0.00 loops=1)
         Role: trim
         Input Batches: 4
         Input Rows: 100
         Output Rows: 0
         Child Request: filter {0} projection {0} max 32
         ->  Custom Scan (TessPack) (actual rows=100.00 loops=1)
               Batch Size: 32
               Rows Kept As: heap tuples
               Batches: 4
               Deformed Datums: 100
               Restarted Datums: 0
               ->  Seq Scan on pack_t (actual rows=100.00 loops=1)
(20 rows)

-- The trim node stops after its first batch with rows.
SET pack_test.trim = 80;
SET pack_test.stop = on;
EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF)
SELECT count(a) FROM pack_t;
                               QUERY PLAN                                
-------------------------------------------------------------------------
 Custom Scan (TessAgg) (actual rows=1.00 loops=1)
   Input Batches: 1
   Input Rows: 32
   Kernel Calls: 0
   Computed Datums: 32
   ->  Custom Scan (tessera_pack_sink) (actual rows=32.00 loops=1)
         Role: sink
         Requested Rows: 0
         Input Batches: 1
         Input Rows: 32
         Output Rows: 32
         Child Request: filter {} projection {0} max 0
         ->  Custom Scan (tessera_pack_sink) (actual rows=32.00 loops=1)
               Role: trim
               Input Batches: 1
               Input Rows: 32
               Output Rows: 32
               Child Request: filter {0} projection {0} max 32
               ->  Custom Scan (TessPack) (actual rows=32.00 loops=1)
                     Batch Size: 32
                     Rows Kept As: heap tuples
                     Batches: 1
                     Deformed Datums: 32
                     Restarted Datums: 0
                     ->  Seq Scan on pack_t (actual rows=32.00 loops=1)
(25 rows)

SELECT count(a), max(a) FROM pack_t;
 count | max 
-------+-----
    32 |  32
(1 row)

RESET pack_test.stop;
-- The smaller batch limit of the sink and the trim node reaches the pack.
SET pack_test.trim = 50;
SET pack_test.batch_rows = 10;
EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF)
SELECT a, b FROM pack_t WHERE a > 45;
                            QUERY PLAN                            
------------------------------------------------------------------
 Custom Scan (tessera_pack_sink) (actual rows=5.00 loops=1)
   Role: sink
   Requested Rows: 10
   Input Batches: 1
   Input Rows: 5
   Output Rows: 5
   Child Request: filter {} projection {0 1} max 10
   ->  Custom Scan (tessera_pack_sink) (actual rows=5.00 loops=1)
         Role: trim
         Input Batches: 6
         Input Rows: 55
         Output Rows: 5
         Child Request: filter {0} projection {0 1} max 10
         ->  Custom Scan (TessPack) (actual rows=55.00 loops=1)
               Batch Size: 10
               Rows Kept As: heap tuples
               Batches: 6
               Deformed Datums: 60
               Restarted Datums: 0
               ->  Seq Scan on pack_t (actual rows=55.00 loops=1)
                     Filter: (a > 45)
                     Rows Removed by Filter: 45
(22 rows)

RESET pack_test.batch_rows;
RESET pack_test.trim;
-- A parent that asks for rows cannot stand above the pack node.
SET pack_test.rows_mode = on;
\set VERBOSITY terse
SELECT count(*) FROM pack_t;
ERROR:  Tessera pack requires a batch-aware parent
\set VERBOSITY default
RESET pack_test.rows_mode;
DROP TABLE pack_t, pack_empty;
DROP FUNCTION tessera_test_pack_paths();
DROP EXTENSION tessera;
