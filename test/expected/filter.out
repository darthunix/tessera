-- A pseudoconstant clause gates the scan: the node stays away.
PREPARE gated(int) AS SELECT count(*) FROM filter_t WHERE a > 150 AND $1 > 0;
EXPLAIN (COSTS OFF) EXECUTE gated(1);
            QUERY PLAN             
-----------------------------------
 Aggregate
   ->  Result
         One-Time Filter: ($1 > 0)
         ->  Seq Scan on filter_t
               Filter: (a > 150)
(5 rows)

EXECUTE gated(1);
 count 
-------
    43
(1 row)

DEALLOCATE above;
DEALLOCATE gated;
RESET plan_cache_mode;
-- A rescan with a changed parameter: a correlated subquery.
EXPLAIN (COSTS OFF)
SELECT o.a, (SELECT count(*) FROM filter_t AS i WHERE i.a > o.a) AS above
FROM filter_t AS o WHERE o.a > 197 ORDER BY o.a;
                             QUERY PLAN                             
--------------------------------------------------------------------
 Sort
   Sort Key: o.a
   ->  Custom Scan (TessFilter) on filter_t o
         Batch Filter: (o.a > 197)
         ->  Custom Scan (TessHeapScan) on filter_t o
         SubPlan expr_1
           ->  Custom Scan (TessAgg)
                 ->  Custom Scan (TessFilter) on filter_t i
                       Batch Filter: (i.a > o.a)
                       ->  Custom Scan (TessHeapScan) on filter_t i
(10 rows)

SELECT o.a, (SELECT count(*) FROM filter_t AS i WHERE i.a > o.a) AS above
FROM filter_t AS o WHERE o.a > 197 ORDER BY o.a;
  a  | above 
-----+-------
 198 |     2
 199 |     1
 200 |     0
(3 rows)

