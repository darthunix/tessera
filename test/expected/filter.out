-- The pack node keeps the scan's tuples: a batch clause deforms its column
-- for every row, the residual its column for the rows that survived.
EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF)
SELECT count(*) FROM filter_t WHERE a > 100 AND c <> 'r150';
                                   QUERY PLAN                                    
---------------------------------------------------------------------------------
 Custom Scan (TessAgg) (actual rows=1.00 loops=1)
   Input Batches: 3
   Input Rows: 85
   ->  Custom Scan (TessFilter) on filter_t (actual rows=85.00 loops=1)
         Filter: (c <> 'r150'::text)
         Rows Removed by Filter: 115
         Batch Filter: (a > 100)
         Rows Removed by Batch Filter: 114
         Rows Removed by Residual Filter: 1
         Input Batches: 4
         Input Rows: 200
         Output Rows: 85
         ->  Custom Scan (TessHeapScan) on filter_t (actual rows=200.00 loops=1)
               Batch Size: 64
               Batches: 4
               Pages: 2
               Deformed Datums: 286
               Restarted Datums: 0
(18 rows)

