--------------+----------
 missing      | 42703
 I            | 42703
 dec          | 0A000
 big          | 0A000
 tod          | 0A000
 ns           | 0A000
 json         | 0A000
 t96          | 0A000
 lst          | 0A000
 n            | 0A000
 t0           | 0A000
 s_unit       | 22023
 i_utf8       | 22023
 day_days     | 22023
 ts_seconds   | 22023
 l_days       | 22023
 i_seconds    | 22023
 l_small      | 42804
 n_days       | 0A000
 l_utf8       | 22023
 i_text       | 42804
 i_text_check | 42804
 i            | ok
 l            | ok
 day          | ok
 ts           | ok
