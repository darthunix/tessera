 {"(0,-57131429,-57128572,-39994.000000000000,2857)","(1,-57158571,-57155713,-39999.000000000000,2858)","(2,-57145714,-57142857,-40004.000000000000,2857)","(3,-57142857,-57140000,-40002.000000000000,2857)","(4,-57140000,-57137143,-40000.000000000000,2857)","(5,-57137143,-57134286,-39998.000000000000,2857)","(6,-57134286,-57131429,-39996.000000000000,2857)"}
