-- Aggregates of one expression under constants, which a serial plan folds
-- into shared states: the participants and the final aggregation keep a
-- state for each.
SELECT regexp_replace(line, ' \(actual.*\)$', '') AS line FROM parallel_explain($$SELECT sum(s), sum(s + 1), avg(s * 2), count(s - 3) FROM parallel_fast$$) AS line
WHERE line ~ '(TessAgg|Partial Mode|Folded)';
                       line                       
--------------------------------------------------
 Custom Scan (TessAgg)
   Partial Mode: Finalize
               ->  Parallel Custom Scan (TessAgg)
                     Partial Mode: Partial
(4 rows)

SELECT parallel_same($$SELECT sum(s), sum(s + 1), avg(s * 2), count(s - 3) FROM parallel_fast$$);
                     parallel_same                     
-------------------------------------------------------
 {"(-399990000,-399970000,-39999.000000000000,20000)"}
(1 row)

SELECT regexp_replace(line, ' \(actual.*\)$', '') AS line FROM parallel_explain($$SELECT id % 7, sum(s), sum(s + 1), avg(s * 2), count(s - 3) FROM parallel_fast GROUP BY id % 7$$) AS line
WHERE line ~ '(TessAgg|Partial Mode|Folded)';
                       line                       
--------------------------------------------------
 Custom Scan (TessAgg)
   Partial Mode: Finalize
               ->  Parallel Custom Scan (TessAgg)
                     Partial Mode: Partial
(4 rows)

SELECT parallel_same($$SELECT id % 7, sum(s), sum(s + 1), avg(s * 2), count(s - 3) FROM parallel_fast GROUP BY id % 7$$);
                                                                                                                                                                             parallel_same                                                                                                                                                                              
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"(0,-57131429,-57128572,-39994.000000000000,2857)","(1,-57158571,-57155713,-39999.000000000000,2858)","(2,-57145714,-57142857,-40004.000000000000,2857)","(3,-57142857,-57140000,-40002.000000000000,2857)","(4,-57140000,-57137143,-40000.000000000000,2857)","(5,-57137143,-57134286,-39998.000000000000,2857)","(6,-57134286,-57131429,-39996.000000000000,2857)"}
(1 row)

-- With the core's Gather its Finalize Aggregate reads the core's own
-- transition values; numeric and bigint sums then go through the core's
-- functions, serialized.
SET tessera.batch_gather = off;
EXPLAIN (COSTS OFF) SELECT sum(n), avg(i4), avg(f8), max(f4) FROM parallel_fast;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather
         Workers Planned: 2
         ->  Parallel Custom Scan (TessAgg)
               Partial Mode: Partial
               ->  Parallel Custom Scan (TessHeapScan) on parallel_fast
(6 rows)

SELECT parallel_same($$SELECT sum(n), avg(u), sum(b), avg(i4), avg(s), sum(s), avg(f8), max(f4), min(u) FROM parallel_fast$$);
                                                                   parallel_same                                                                    
----------------------------------------------------------------------------------------------------------------------------------------------------
 {"(300000000000005145670.000000000000000001,NaN,92233720368547768070000,-21.2185148457096191,-19999.500000000000,-399990000,5000.25,249.75,0.25)"}
(1 row)

RESET tessera.batch_gather;
DROP TABLE parallel_fast;
-- A parameter of a generic plan in an argument.
PREPARE shifted(int) AS SELECT sum(a + $1) FROM parallel_t WHERE a > 4990;
SET plan_cache_mode = force_generic_plan;
EXECUTE shifted(1);
  sum  
-------
 39974
(1 row)

EXECUTE shifted(1000);
  sum  
-------
 47966
(1 row)

RESET plan_cache_mode;
DEALLOCATE shifted;
-- GROUP BY under a Gather: a table of groups in each participant, and the
-- node's grouping over TessGather merging their partial values, counts
-- and sums added as int8, extremes compared, and applying HAVING, where
-- the core's Finalize HashAggregate would merge them row by row. A group
-- of NULL values only (sum, min and max NULL, count(a) 0), int8 extremes.
EXPLAIN (COSTS OFF) SELECT b, count(*), sum(a), min(a), max(a) FROM parallel_t WHERE a > 100 GROUP BY b;
                                   QUERY PLAN                                    
---------------------------------------------------------------------------------
 Custom Scan (TessAgg)
   Group Key: b
   Partial Mode: Finalize
   ->  Custom Scan (TessGather)
         Workers Planned: 2
         ->  Parallel Custom Scan (TessSend)
               ->  Parallel Custom Scan (TessAgg)
                     Group Key: b
                     Partial Mode: Partial
                     ->  Parallel Custom Scan (TessFilter) on parallel_t
                           Batch Filter: (a > 100)
                           ->  Parallel Custom Scan (TessHeapScan) on parallel_t
(12 rows)

SELECT parallel_same($$SELECT b, count(*), sum(a), min(a), max(a) FROM parallel_t WHERE a > 100 GROUP BY b$$);
                                                                                                                                  parallel_same                                                                                                                                  
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"(0,420,1073100,110,5000)","(1,420,1067220,101,4981)","(2,420,1071140,102,4992)","(3,420,1070160,103,4993)","(4,420,1069180,104,4994)","(5,420,1073100,115,4995)","(6,420,1072120,106,4996)","(7,420,1071140,107,4997)","(8,420,1070160,108,4988)","(9,420,1074080,109,4999)"}
(1 row)

SELECT parallel_same($$SELECT a % 7, count(*), count(a) FROM parallel_t GROUP BY a % 7 HAVING count(a) > 100$$);
                                     parallel_same                                     
---------------------------------------------------------------------------------------
 {"(1,715,715)","(2,715,715)","(3,714,714)","(4,714,714)","(5,714,714)","(6,714,714)"}
(1 row)

EXPLAIN (COSTS OFF) SELECT b, count(*), count(a) FROM parallel_t GROUP BY b HAVING count(a) > 428;
                                QUERY PLAN                                 
