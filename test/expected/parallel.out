                           Group Key: (parallel_keys.c % 5)
                           ->  Custom Scan (TessGather)
                                 Output: ((parallel_keys.c % 5))
                                 Workers Planned: 2
                                 ->  Parallel Custom Scan (TessSend)
                                       Output: ((parallel_keys.c % 5))
                                       ->  Parallel Custom Scan (TessAgg)
                                             Output: ((parallel_keys.c % 5))
                                             Group Key: (parallel_keys.c % 5)
                                             Partial Mode: Partial
                                             ->  Parallel Custom Scan (TessHeapScan) on public.parallel_keys
                                                   Output: (parallel_keys.c % 5)
