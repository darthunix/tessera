              QUERY PLAN               
---------------------------------------
 Gather
   Workers Planned: 2
   ->  Parallel Seq Scan on parallel_t
         Filter: (a > 4990)
(4 rows)

RESET tessera.enable;
DROP TABLE parallel_t;
DROP FUNCTION parallel_same(text);
DROP FUNCTION plan_property(text, text, text);
