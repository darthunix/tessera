   Partial Mode: Finalize
   ->  Custom Scan (TessGather)
         Workers Planned: 2
         ->  Parallel Custom Scan (TessSend)
               ->  Parallel Custom Scan (TessAgg)
                     Partial Mode: Partial
                     ->  Custom Scan (TessPack)
                           ->  Parallel Bitmap Heap Scan on parallel_bitmap
                                 Recheck Cond: (k < 60000)
                                 ->  Bitmap Index Scan on parallel_bitmap_k
                                       Index Cond: (k < 60000)
(12 rows)

SELECT parallel_same($$SELECT count(*), sum(w) FROM parallel_bitmap WHERE k < 60000$$);
