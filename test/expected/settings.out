-- Loading and settings (plan 4.24, review items 9 and 18). Nothing of
-- Tessera is preloaded here, so the modules load in this session's order.
SELECT current_setting('shared_preload_libraries') !~ 'tessera'
   AND current_setting('session_preload_libraries') !~ 'tessera' AS nothing_preloaded;
 nothing_preloaded 
-------------------
 t
(1 row)

-- A module without the bridge: the bridge must be loaded first, and the
-- failed load leaves nothing behind, so it can be loaded again after it.
LOAD 'tessera_nodes';
ERROR:  Tessera bridge is not loaded
HINT:  Load the tessera library first: LOAD 'tessera', or list tessera first in shared_preload_libraries or session_preload_libraries.
LOAD 'tessera_kernels';
ERROR:  Tessera bridge must be loaded before tessera_kernels
HINT:  Load the tessera library first: LOAD 'tessera', or list tessera first in shared_preload_libraries or session_preload_libraries.
-- Settings given before the modules that define them keep their values:
-- the prefix is reserved only once tessera_nodes has defined every
-- tessera.* setting, and then a name no module defines goes with a WARNING.
SET tessera.gather_tuple_share = 0.5;
SET tessera.misspelt = 1;
LOAD 'tessera';
SHOW tessera.enable;
 tessera.enable 
----------------
 on
(1 row)

SET tessera.scan_cost_factor = 0.7;
LOAD 'tessera_nodes';
WARNING:  invalid configuration parameter name "tessera.misspelt", removing it
DETAIL:  "tessera" is now a reserved prefix.
SHOW tessera.gather_tuple_share;
 tessera.gather_tuple_share 
----------------------------
 0.5
(1 row)

SHOW tessera.scan_cost_factor;
 tessera.scan_cost_factor 
--------------------------
 0.7
(1 row)

-- The prefix is reserved now.
SET tessera.misspelt_again = 1;
ERROR:  invalid configuration parameter name "tessera.misspelt_again"
DETAIL:  "tessera" is a reserved prefix.
LOAD 'tessera_kernels';
-- Each module reports its name and version (PG_MODULE_MAGIC_EXT).
SELECT module_name, version FROM pg_get_loaded_modules()
WHERE module_name LIKE 'tessera%' ORDER BY module_name;
   module_name   | version 
-----------------+---------
 tessera         | 0.1.0
 tessera_kernels | 0.1.0
 tessera_nodes   | 0.1.0
(3 rows)

-- Every setting changes plans: EXPLAIN (SETTINGS) lists the ones not at
-- their defaults, tessera.enable among them.
SELECT name FROM pg_settings
WHERE name LIKE 'tessera.%'
  AND (NOT 'EXPLAIN' = ANY (pg_settings_get_flags(name))
       OR 'NOT_IN_SAMPLE' = ANY (pg_settings_get_flags(name)));
 name 
------
(0 rows)

SET tessera.enable = off;
EXPLAIN (COSTS OFF, SETTINGS) SELECT 1;
                                               QUERY PLAN                                               
--------------------------------------------------------------------------------------------------------
 Result
 Settings: tessera.scan_cost_factor = '0.7', tessera.gather_tuple_share = '0.5', tessera.enable = 'off'
(2 rows)

RESET tessera.enable;
