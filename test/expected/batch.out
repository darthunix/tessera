\getenv libdir PG_LIBDIR
\getenv dlsuffix PG_DLSUFFIX
\set batch_test :libdir '/tessera_batch_test' :dlsuffix
LOAD :'batch_test';
CREATE FUNCTION tessera_test_batch()
RETURNS boolean
AS :'batch_test', 'tessera_test_batch'
LANGUAGE C STRICT;
SELECT tessera_test_batch() AS batch \gset
\echo :batch
t
DROP FUNCTION tessera_test_batch();
