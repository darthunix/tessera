-- A shared table, with no worker started: the leader links its chunks,
-- splits them as the table spills, and loads a partition on disk block
-- by block into the query's shared memory.
SET work_mem = '256kB';
SET max_parallel_workers_per_gather = 2;
SET max_parallel_workers = 0;
SET parallel_setup_cost = 0;
SET parallel_tuple_cost = 0;
SET min_parallel_table_scan_size = 0;
SET tessera.scan_parallel_setup_cost = 0;
SET tessera.scan_worker_page_cost = 0;
SELECT loop_turns(:'loop_module', 'link', $$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM loop_outer o JOIN loop_inner i ON o.k = i.k$$) > 1 AS turns;
 turns 
