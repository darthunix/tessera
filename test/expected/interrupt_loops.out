(1 row)

-- With workers that take the build and the rounds, and no leader: one
-- cancelled in its load of a round, or in its link of a table that fits
-- in memory, where each worker links the chunks it built, fails the
-- query, and the others, at the barrier or past it, end with it.
RESET max_parallel_workers;
SET parallel_leader_participation = off;
SELECT workers_launched($$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM loop_outer o JOIN loop_inner i ON o.k = i.k$$) AS workers;
 workers 
---------
       2
(1 row)

SELECT loop_cancelled_everywhere(:'loop_module', 'load', $$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM loop_outer o JOIN loop_inner i ON o.k = i.k$$);
 loop_cancelled_everywhere 
---------------------------
 57014
(1 row)

SET work_mem = '1MB';
SELECT workers_launched($$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM loop_outer o JOIN loop_inner i ON o.k = i.k$$) AS workers;
 workers 
---------
       2
(1 row)

SELECT loop_cancelled_everywhere(:'loop_module', 'link', $$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM loop_outer o JOIN loop_inner i ON o.k = i.k$$);
 loop_cancelled_everywhere 
---------------------------
 57014
(1 row)

RESET parallel_leader_participation;
RESET tessera.scan_worker_page_cost;
RESET tessera.scan_parallel_setup_cost;
RESET min_parallel_table_scan_size;
RESET parallel_tuple_cost;
RESET parallel_setup_cost;
RESET max_parallel_workers;
SET max_parallel_workers_per_gather = 0;
-- The grouping, by hash: its first split; the links of the partitions
-- kept in memory into the table it goes on with; the eviction of a
-- partition, chunk by chunk to disk; the chunks in memory of the
-- partitions with records on disk, written as a level is given out; and
-- the links of a partition wholly in memory as it is given out.
SET enable_sort = off;
SET work_mem = '512kB';
SELECT loop_turns(:'loop_module', 'group split', $$SELECT count(*), sum(s) FROM (SELECT k, sum(k) AS s FROM loop_outer GROUP BY k) AS q$$) > 1 AS turns;
 turns 
-------
 t
(1 row)

SELECT loop_cancelled(:'loop_module', 'group split', $$SELECT count(*), sum(s) FROM (SELECT k, sum(k) AS s FROM loop_outer GROUP BY k) AS q$$);
