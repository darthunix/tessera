SET work_mem = '64kB';
SELECT loop_turns(:'loop_module', 'tails', $$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM loop_outer o JOIN loop_inner i ON o.k = i.k$$) > 1 AS turns;
