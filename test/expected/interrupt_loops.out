(1 row)

SELECT loop_cancelled(:'loop_module', 'shared flush', $$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM loop_outer o JOIN loop_inner i ON o.k = i.k$$);
   loop_cancelled   
--------------------
