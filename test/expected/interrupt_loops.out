-- A cancel ends a spill's loop that can run long at its next turn, in
-- a join and in a grouping: the first split of a table, the demotion
-- and the eviction of a partition, the writing of its value chunks and
-- of the tails, the links of a table's chunks, a round's load. Each turn
-- checks for a cancel and then passes the loop's name to the injection
-- point "tessera-loop", whose callback marks a cancel pending in the
-- loop's first turn, as SIGINT does: the query ends after that one turn,
-- where without the check the loop would run on first. Without
-- injection points the suite ends here.
\getenv libdir PG_LIBDIR
\getenv dlsuffix PG_DLSUFFIX
\set spill_test :libdir '/tessera_spill_test' :dlsuffix
\set interrupt_test :libdir '/tessera_interrupt_test' :dlsuffix
\set loop_module :libdir '/tessera_interrupt_test'
CREATE FUNCTION tessera_test_spill_injection()
RETURNS boolean
AS :'spill_test', 'tessera_test_spill_injection'
LANGUAGE C STRICT;
SELECT NOT tessera_test_spill_injection() AS skip \gset
\if :skip
DROP FUNCTION tessera_test_spill_injection();
\quit
\endif
CREATE EXTENSION tessera;
LOAD 'tessera_nodes';
LOAD 'tessera_kernels';
CREATE FUNCTION interrupt_loop(text, text, boolean, boolean) RETURNS void
AS :'interrupt_test', 'tessera_test_interrupt_loop' LANGUAGE C;
CREATE FUNCTION interrupt_turns() RETURNS integer
AS :'interrupt_test', 'tessera_test_interrupt_turns' LANGUAGE C STRICT;
-- The turns of a loop in a query that runs to its end, every call of the
-- loop counted.
CREATE FUNCTION loop_turns(library text, loop text, query text) RETURNS integer
LANGUAGE plpgsql AS $$
DECLARE
    turns integer;
BEGIN
    PERFORM interrupt_loop(library, loop, false, false);
    EXECUTE query;
    turns := interrupt_turns();
    PERFORM interrupt_loop(library, NULL, false, false);
    RETURN turns;
END $$;
-- The query, cancelled in the loop's first turn: its SQLSTATE and the
-- turns the loop took.
CREATE FUNCTION loop_cancelled(library text, loop text, query text) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
    turns integer;
BEGIN
    PERFORM interrupt_loop(library, loop, true, false);
    BEGIN
        EXECUTE query;
    EXCEPTION WHEN query_canceled THEN
        turns := interrupt_turns();
        PERFORM interrupt_loop(library, NULL, false, false);
        RETURN format('%s after %s turn', SQLSTATE, turns);
    END;
    turns := interrupt_turns();
    PERFORM interrupt_loop(library, NULL, false, false);
    RETURN format('no cancel, %s turns', turns);
END $$;
-- The query, its loop cancelled in the first turn of every process that
-- takes it, workers too: its SQLSTATE.
CREATE FUNCTION loop_cancelled_everywhere(library text, loop text, query text) RETURNS text
LANGUAGE plpgsql AS $$
BEGIN
    PERFORM interrupt_loop(library, loop, true, true);
    BEGIN
        EXECUTE query;
    EXCEPTION WHEN query_canceled THEN
        PERFORM interrupt_loop(library, NULL, false, false);
        RETURN SQLSTATE;
    END;
    PERFORM interrupt_loop(library, NULL, false, false);
    RETURN 'no cancel';
END $$;
-- The workers a query's Gather launched.
CREATE FUNCTION workers_launched(query text) RETURNS integer
LANGUAGE plpgsql AS $$
DECLARE
    plan jsonb;
BEGIN
    EXECUTE format('EXPLAIN (ANALYZE, FORMAT JSON, TIMING OFF, SUMMARY OFF, BUFFERS OFF, COSTS OFF) %s', query)
        INTO plan;
    RETURN jsonb_path_query_first(plan, '$.**."Workers Launched"')::integer;
END $$;
-- 20000 keys, each once on the inner side and twice on the outer, with
-- text on both; and 200000 groups.
CREATE TABLE loop_inner (k int, t text) WITH (autovacuum_enabled = off);
INSERT INTO loop_inner SELECT i, repeat('i', 30) || i FROM generate_series(1, 20000) AS i;
CREATE TABLE loop_outer (k int, t text) WITH (autovacuum_enabled = off);
INSERT INTO loop_outer SELECT i % 20000 + 1, repeat('o', 30) || i FROM generate_series(1, 40000) AS i;
CREATE TABLE loop_groups (k int) WITH (autovacuum_enabled = off);
INSERT INTO loop_groups SELECT i FROM generate_series(1, 200000) AS i;
ANALYZE loop_inner, loop_outer, loop_groups;
SET max_parallel_workers_per_gather = 0;
-- The join: its first split, of every chunk of the table built so far;
-- the demotion of a partition kept in memory, chunk by chunk to disk.
SET work_mem = '512kB';
SELECT loop_turns(:'loop_module', 'split', $$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM loop_outer o JOIN loop_inner i ON o.k = i.k$$) > 1 AS turns;
 turns 
-------
 t
(1 row)

SELECT loop_cancelled(:'loop_module', 'split', $$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM loop_outer o JOIN loop_inner i ON o.k = i.k$$);
   loop_cancelled   
--------------------
 57014 after 1 turn
(1 row)

SET work_mem = '64kB';
SELECT loop_turns(:'loop_module', 'demote', $$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM loop_outer o JOIN loop_inner i ON o.k = i.k$$) > 1 AS turns;
 turns 
-------
 t
(1 row)

SELECT loop_cancelled(:'loop_module', 'demote', $$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM loop_outer o JOIN loop_inner i ON o.k = i.k$$);
   loop_cancelled   
--------------------
 57014 after 1 turn
(1 row)

