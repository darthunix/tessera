SET work_mem = '1MB';
SELECT loop_turns(:'loop_module', 'values', $$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM loop_outer o JOIN loop_inner i ON o.k = i.k$$) > 1 AS turns;
