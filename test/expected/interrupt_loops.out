-- The partitions of a shared table at the end of its build, those on
-- disk with their tails written.
SELECT loop_turns(:'loop_module', 'shared flush', $$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM loop_outer o JOIN loop_inner i ON o.k = i.k$$) > 1 AS turns;
 turns 
-------
