RESET enable_sort;
RESET work_mem;
RESET max_parallel_workers_per_gather;
DROP TABLE loop_groups, loop_outer, loop_inner;
DROP FUNCTION workers_launched(text), loop_cancelled_everywhere(text, text, text),
    loop_cancelled(text, text, text), loop_turns(text, text, text);
DROP FUNCTION interrupt_loop(text, text, boolean, boolean), interrupt_turns();
DROP FUNCTION tessera_test_spill_injection();
DROP EXTENSION tessera;
