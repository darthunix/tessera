\getenv libdir PG_LIBDIR
\getenv dlsuffix PG_DLSUFFIX
\set heap_batch_test :libdir '/tessera_heap_batch_test' :dlsuffix
LOAD :'heap_batch_test';
CREATE FUNCTION tessera_test_heap_batch(regclass)
RETURNS boolean
AS :'heap_batch_test', 'tessera_test_heap_batch'
LANGUAGE C STRICT;
CREATE FUNCTION tessera_test_heap_batch_errors(integer, regclass)
RETURNS void
AS :'heap_batch_test', 'tessera_test_heap_batch_errors'
LANGUAGE C STRICT;
CREATE FUNCTION tessera_test_heap_batch_nulls(regclass)
RETURNS boolean
AS :'heap_batch_test', 'tessera_test_heap_batch_nulls'
LANGUAGE C STRICT;
CREATE FUNCTION tessera_test_heap_batch_back(regclass, regclass)
RETURNS boolean
AS :'heap_batch_test', 'tessera_test_heap_batch_back'
LANGUAGE C STRICT;
-- Wide rows, so that one batch of 64 rows spans several pages.
CREATE TABLE heap_batch_t (a int, b text, c bigint);
INSERT INTO heap_batch_t
SELECT i, CASE WHEN i % 3 = 0 THEN NULL ELSE repeat('x', 300) END, i * 10
FROM generate_series(1, 200) AS i;
SELECT count(DISTINCT (ctid::text::point)[0]) > 4 AS pages FROM heap_batch_t;
 pages 
-------
 t
(1 row)

SELECT tessera_test_heap_batch('heap_batch_t') AS heap_batch \gset
\echo :heap_batch
t
-- By-value columns at cached offsets, with NULLs moving the second one.
CREATE TABLE heap_batch_n (a int, b int);
INSERT INTO heap_batch_n
SELECT CASE WHEN i % 5 = 0 THEN NULL ELSE i END, i * 2
FROM generate_series(1, 100) AS i;
SELECT tessera_test_heap_batch_nulls('heap_batch_n') AS heap_batch_nulls \gset
\echo :heap_batch_nulls
t
DROP TABLE heap_batch_n;
-- Columns behind a row's cursor read in ascending order continue one walk
-- of the tuple; b is NULL in every fourth row. heap_batch_b2 holds longer
-- texts, so that a back cursor left from the other table would read b at
-- the wrong place.
CREATE TABLE heap_batch_b (a text, b text, c text, d bigint);
INSERT INTO heap_batch_b
SELECT 'a' || i, CASE WHEN i % 4 = 0 THEN NULL ELSE 'b' || i END, 'c' || i, i
FROM generate_series(1, 100) AS i;
CREATE TABLE heap_batch_b2 (a text, b text, c text, d bigint);
INSERT INTO heap_batch_b2
SELECT repeat('a', 20) || i, CASE WHEN i % 4 = 0 THEN NULL ELSE repeat('b', 20) || i END,
       repeat('c', 20) || i, i
FROM generate_series(1, 100) AS i;
SELECT tessera_test_heap_batch_back('heap_batch_b', 'heap_batch_b2') AS heap_batch_back \gset
\echo :heap_batch_back
t
DROP TABLE heap_batch_b, heap_batch_b2;
CREATE FUNCTION tessera_test_heap_batch_keep(regclass)
RETURNS boolean
AS :'heap_batch_test', 'tessera_test_heap_batch_keep'
LANGUAGE C STRICT;
-- A walk that keeps the columns read behind the cursor: k is NULL in
-- every tenth row and b in every fourth; d is added after the first 40
-- rows, which are shorter and take its default.
CREATE TABLE heap_batch_k (k int, a text, b text, c text);
INSERT INTO heap_batch_k
SELECT CASE WHEN i % 10 = 0 THEN NULL ELSE i END, 'a' || i,
       CASE WHEN i % 4 = 0 THEN NULL ELSE 'b' || i END, 'c' || i
FROM generate_series(1, 40) AS i;
ALTER TABLE heap_batch_k ADD COLUMN d bigint DEFAULT 7;
INSERT INTO heap_batch_k
SELECT CASE WHEN i % 10 = 0 THEN NULL ELSE i END, 'a' || i,
       CASE WHEN i % 4 = 0 THEN NULL ELSE 'b' || i END, 'c' || i, i
FROM generate_series(41, 100) AS i;
SELECT tessera_test_heap_batch_keep('heap_batch_k') AS heap_batch_keep \gset
\echo :heap_batch_keep
t
DROP TABLE heap_batch_k;
DROP FUNCTION tessera_test_heap_batch_keep(regclass);
\set VERBOSITY terse
SELECT tessera_test_heap_batch_errors(0, 'heap_batch_t');
ERROR:  Tessera heap batch is full
SELECT tessera_test_heap_batch_errors(1, 'heap_batch_t');
ERROR:  Tessera heap batch column is out of range
SELECT tessera_test_heap_batch_errors(2, 'heap_batch_t');
ERROR:  Tessera heap batch received a row mask of another batch
SELECT tessera_test_heap_batch_errors(3, 'heap_batch_t');
ERROR:  Tessera heap batch needs a descriptor before tuples
SELECT tessera_test_heap_batch_errors(4, 'heap_batch_t');
ERROR:  Tessera heap batch is full
SELECT tessera_test_heap_batch_errors(5, 'heap_batch_t');
ERROR:  Tessera heap batch needs a pinned page
\set VERBOSITY default
DROP TABLE heap_batch_t;
DROP FUNCTION tessera_test_heap_batch_nulls(regclass);
DROP FUNCTION tessera_test_heap_batch_errors(integer, regclass);
DROP FUNCTION tessera_test_heap_batch(regclass);
