(1 row)

SELECT damaged(:'damage_module', 'next', :last_block, $q$DO $do$DECLARE c SCROLL CURSOR FOR SELECT k, t FROM damage_outer ORDER BY k; r record; BEGIN OPEN c; FETCH LAST FROM c INTO r; FETCH ABSOLUTE 1 FROM c INTO r; END $do$$q$);
                            damaged                             
