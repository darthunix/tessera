(1 row)

SELECT damaged(:'damage_module', 'words', 1, $$SELECT k, t FROM damage_outer ORDER BY k$$);
                                damaged                                 
------------------------------------------------------------------------
 XX001: a chunk of columns read back holds 2 words where 3 were written
(1 row)

SELECT damaged(:'damage_module', 'rows', 1, $$SELECT k, t FROM damage_outer ORDER BY k$$);
                                 damaged                                 
-------------------------------------------------------------------------
 XX001: a chunk of columns read back holds 63 rows where 64 were written
(1 row)

SELECT damaged(:'damage_module', 'value', 1, $$SELECT k, t FROM damage_outer ORDER BY k$$);
                                       damaged                                        
--------------------------------------------------------------------------------------
 XX001: row 0 read back holds a value that runs past its chunk of values, in column 1
(1 row)

SELECT damaged(:'damage_module', 'ref', 1, $$SELECT k, t FROM damage_outer ORDER BY k$$);
                                      damaged                                      
-----------------------------------------------------------------------------------
 XX001: row 0 read back refers to a value outside its chunk of values, in column 1
(1 row)

SELECT damaged(:'damage_module', 'zero', 1, $$SELECT k, t FROM damage_outer ORDER BY k$$);
                                      damaged                                      
-----------------------------------------------------------------------------------
 XX001: row 0 read back refers to a value outside its chunk of values, in column 1
(1 row)

-- A scrollable cursor reads the one run the last merge wrote by blocks,
-- the last of them its first block, for FETCH ABSOLUTE 1: that block of
-- a row fewer than the run's record of it. A run of the query counts the
-- chunks of columns it reads.
SELECT damaged(:'damage_module', 'rows', 1000000, $q$DO $do$DECLARE c SCROLL CURSOR FOR SELECT k, t FROM damage_outer ORDER BY k; r record; BEGIN OPEN c; FETCH LAST FROM c INTO r; FETCH ABSOLUTE 1 FROM c INTO r; END $do$$q$);
 damaged  
----------
 no error
(1 row)

SELECT tessera_test_spill_damage_seen() AS last_block \gset
SELECT damaged(:'damage_module', 'rows', :last_block, $q$DO $do$DECLARE c SCROLL CURSOR FOR SELECT k, t FROM damage_outer ORDER BY k; r record; BEGIN OPEN c; FETCH LAST FROM c INTO r; FETCH ABSOLUTE 1 FROM c INTO r; END $do$$q$);
                                 damaged                                 
-------------------------------------------------------------------------
 XX001: a chunk of columns read back holds 63 rows where 64 were written
(1 row)

