-- What a join, a sort and a grouping read back from their files is
-- checked against what they wrote: a block damaged past the reader's own
-- checks, as a node reads it, fails the query as damaged data, SQLSTATE
-- XX001. The damage comes through injection points of PostgreSQL, so
-- this suite runs only on a build with them; on another it ends here.
\getenv libdir PG_LIBDIR
\getenv dlsuffix PG_DLSUFFIX
\set spill_test :libdir '/tessera_spill_test' :dlsuffix
\set damage_module :libdir '/tessera_spill_test'
CREATE FUNCTION tessera_test_spill_injection()
RETURNS boolean
AS :'spill_test', 'tessera_test_spill_injection'
LANGUAGE C STRICT;
SELECT NOT tessera_test_spill_injection() AS skip \gset
\if :skip
DROP FUNCTION tessera_test_spill_injection();
\quit
\endif
CREATE EXTENSION tessera;
LOAD 'tessera_nodes';
LOAD 'tessera_kernels';
CREATE FUNCTION tessera_test_spill_damage(text, text, integer)
RETURNS void
AS :'spill_test', 'tessera_test_spill_damage'
LANGUAGE C;
CREATE FUNCTION tessera_test_spill_damage_seen()
RETURNS integer
AS :'spill_test', 'tessera_test_spill_damage_seen'
LANGUAGE C STRICT;
-- The query's error, with the nth block of a kind damaged as the node
-- reads it; 'no error' when the query ends. The blocks a node wrote, and
-- the one it read before, are counts of the build: N.
CREATE FUNCTION damaged(library text, what text, nth integer, query text)
RETURNS text
LANGUAGE plpgsql AS $$
BEGIN
    PERFORM tessera_test_spill_damage(library, what, nth);
    BEGIN
        EXECUTE query;
    EXCEPTION WHEN OTHERS THEN
        PERFORM tessera_test_spill_damage(library, NULL, 0);
        RETURN SQLSTATE || ': ' ||
            regexp_replace(SQLERRM, '(of|chunk) \d+ (written|after)', '\1 N \2', 'g');
    END;
    PERFORM tessera_test_spill_damage(library, NULL, 0);
    RETURN 'no error';
END
$$;
-- A counter of a node of the query's plan, which shows the path that
-- reads a block back.
CREATE FUNCTION node_property(query text, node text, name text) RETURNS text
LANGUAGE plpgsql AS $$
DECLARE
    plan jsonb;
BEGIN
    EXECUTE format('EXPLAIN (ANALYZE, VERBOSE, FORMAT JSON, TIMING OFF, SUMMARY OFF, BUFFERS OFF, COSTS OFF) %s', query)
        INTO plan;
    RETURN jsonb_path_query_first(plan,
        format('$[0]."Plan".** ? (@."Custom Plan Provider" == "%s").%I', node, name)::jsonpath)::text;
END $$;
-- spec: spill-format/Damage under a node
-- 20000 keys, each once on the inner side and twice on the outer, with
-- text on both.
CREATE TABLE damage_inner (k int, t text) WITH (autovacuum_enabled = off);
INSERT INTO damage_inner SELECT i, repeat('i', 30) || i FROM generate_series(1, 20000) AS i;
CREATE TABLE damage_outer (k int, t text) WITH (autovacuum_enabled = off);
INSERT INTO damage_outer SELECT i % 20000 + 1, repeat('o', 30) || i FROM generate_series(1, 40000) AS i;
ANALYZE damage_inner, damage_outer;
SET max_parallel_workers_per_gather = 0;
SET work_mem = '64kB';
-- Every partition of the join on disk, its inner records and its outer
-- rows read back.
SET tessera.join_spill_resident_share = 0;
-- The join, text on both sides: the first block read back is the inner
-- side's; the first chunk of columns is outer rows.
EXPLAIN (COSTS OFF) SELECT count(*), sum(length(i.t)), sum(length(o.t))
FROM damage_outer o JOIN damage_inner i ON o.k = i.k;
                        QUERY PLAN                        
----------------------------------------------------------
 Custom Scan (TessAgg)
   ->  Custom Scan (TessHashJoin)
         Hash Cond: (o.k = i.k)
         ->  Custom Scan (TessHeapScan) on damage_outer o
         ->  Custom Scan (TessHeapScan) on damage_inner i
(5 rows)

SELECT damaged(:'damage_module', NULL, 0, $$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM damage_outer o JOIN damage_inner i ON o.k = i.k$$);
 damaged  
----------
 no error
(1 row)

-- A block of records read as columns; an inner block of values numbered
-- past those written; an inner value past its chunk.
SELECT damaged(:'damage_module', 'kind', 1, $$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM damage_outer o JOIN damage_inner i ON o.k = i.k$$);
                                 damaged                                  
--------------------------------------------------------------------------
 XX001: Tessera read back a spilled block of kind 3 where it wrote kind 1
(1 row)

SELECT damaged(:'damage_module', 'number', 1, $$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM damage_outer o JOIN damage_inner i ON o.k = i.k$$);
                            damaged                             
----------------------------------------------------------------
 XX001: Tessera read back spilled block 1073741824 of N written
(1 row)

SELECT damaged(:'damage_module', 'value', 1, $$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM damage_outer o JOIN damage_inner i ON o.k = i.k$$);
                                  damaged                                   
----------------------------------------------------------------------------
 XX001: Tessera row read back refers to a value outside its chunk of values
(1 row)

-- An inner block of values numbered as the one read before it, which
-- the piece already holds.
SELECT damaged(:'damage_module', 'again', 2, $$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM damage_outer o JOIN damage_inner i ON o.k = i.k$$);
                      damaged                      
---------------------------------------------------
 XX001: TessHashJoin read back value chunk 3 twice
(1 row)

-- Outer rows: a chunk of a word fewer; a word that refers past every
-- chunk; a word of 0 its row does not mark NULL.
SELECT damaged(:'damage_module', 'words', 1, $$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM damage_outer o JOIN damage_inner i ON o.k = i.k$$);
                            damaged                             
----------------------------------------------------------------
 XX001: Tessera read back a chunk of 1 columns where it wrote 2
(1 row)

SELECT damaged(:'damage_module', 'ref', 1, $$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM damage_outer o JOIN damage_inner i ON o.k = i.k$$);
                                  damaged                                   
----------------------------------------------------------------------------
 XX001: Tessera row read back refers to a value outside its chunk of values
(1 row)

SELECT damaged(:'damage_module', 'zero', 1, $$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM damage_outer o JOIN damage_inner i ON o.k = i.k$$);
                                  damaged                                   
----------------------------------------------------------------------------
 XX001: Tessera row read back refers to a value outside its chunk of values
(1 row)

-- The last block the join reads is a chunk of outer rows of its last
-- partition: read as records. A run of the query counts the blocks.
SELECT damaged(:'damage_module', 'kind', 1000000, $$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM damage_outer o JOIN damage_inner i ON o.k = i.k$$);
 damaged  
----------
 no error
(1 row)

SELECT tessera_test_spill_damage_seen() AS last_block \gset
SELECT damaged(:'damage_module', 'kind', :last_block, $$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM damage_outer o JOIN damage_inner i ON o.k = i.k$$);
                                 damaged                                  
--------------------------------------------------------------------------
 XX001: Tessera read back a spilled block of kind 1 where it wrote kind 3
(1 row)

-- An inner side of keys alone: every block of values is outer rows', a
-- value past its chunk, and a block numbered past the one read with it.
SELECT damaged(:'damage_module', 'value', 1, $$SELECT count(*), sum(length(o.t)) FROM damage_outer o JOIN damage_inner i ON o.k = i.k$$);
                                  damaged                                   
----------------------------------------------------------------------------
 XX001: Tessera row read back refers to a value outside its chunk of values
(1 row)

SELECT damaged(:'damage_module', 'number', 1, $$SELECT count(*), sum(length(o.t)) FROM damage_outer o JOIN damage_inner i ON o.k = i.k$$);
                              damaged                               
--------------------------------------------------------------------
 XX001: TessHashJoin read back value chunk N after chunk 1073741824
(1 row)

-- Inner records whose used mark ends no record, which the hash table
-- refuses: split into the partitions of a level below at this work_mem,
-- and linked into a partition's table at one where every partition
-- fits.
SELECT node_property($$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM damage_outer o JOIN damage_inner i ON o.k = i.k$$, 'TessHashJoin', 'Split Partitions')::int > 0 AS split;
 split 
-------
 t
(1 row)

SELECT damaged(:'damage_module', 'mark', 1, $$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM damage_outer o JOIN damage_inner i ON o.k = i.k$$);
                                                       damaged                                                        
----------------------------------------------------------------------------------------------------------------------
 XX001: Tessera read back a damaged chunk of records: table chunk 1 has a used mark of 8167 bytes that ends no record
(1 row)

SET work_mem = '512kB';
SELECT node_property($$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM damage_outer o JOIN damage_inner i ON o.k = i.k$$, 'TessHashJoin', 'Split Partitions') IS NULL AND
       node_property($$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM damage_outer o JOIN damage_inner i ON o.k = i.k$$, 'TessHashJoin', 'Spilled Chunks')::int > 0 AS linked;
 linked 
--------
 t
(1 row)

SELECT damaged(:'damage_module', 'mark', 1, $$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM damage_outer o JOIN damage_inner i ON o.k = i.k$$);
                                                        damaged                                                        
-----------------------------------------------------------------------------------------------------------------------
 XX001: Tessera read back a damaged chunk of records: table chunk 0 has a used mark of 16367 bytes that ends no record
(1 row)

-- A shared table, with no worker started: the leader loads each
-- partition into the query's shared memory, linking each chunk as it
-- reads it.
SET work_mem = '256kB';
SET max_parallel_workers_per_gather = 2;
SET max_parallel_workers = 0;
SET parallel_setup_cost = 0;
SET parallel_tuple_cost = 0;
SET min_parallel_table_scan_size = 0;
SET tessera.scan_parallel_setup_cost = 0;
SET tessera.scan_worker_page_cost = 0;
SELECT node_property($$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM damage_outer o JOIN damage_inner i ON o.k = i.k$$, 'TessHashJoin', 'Partitions Joined Together')::int > 0 AND
       node_property($$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM damage_outer o JOIN damage_inner i ON o.k = i.k$$, 'TessHashJoin', 'Partitions Joined Alone') IS NULL AS together;
 together 
----------
 t
(1 row)

SELECT damaged(:'damage_module', 'mark', 1, $$SELECT count(*), sum(length(i.t)), sum(length(o.t)) FROM damage_outer o JOIN damage_inner i ON o.k = i.k$$);
                                                       damaged                                                        
----------------------------------------------------------------------------------------------------------------------
 XX001: Tessera read back a damaged chunk of records: table chunk 0 has a used mark of 8167 bytes that ends no record
(1 row)

RESET tessera.scan_worker_page_cost;
RESET tessera.scan_parallel_setup_cost;
RESET min_parallel_table_scan_size;
RESET parallel_tuple_cost;
RESET parallel_setup_cost;
RESET max_parallel_workers;
SET max_parallel_workers_per_gather = 0;
SET work_mem = '64kB';
RESET tessera.join_spill_resident_share;
-- The sort: runs on disk, merged.
EXPLAIN (COSTS OFF) SELECT k, t FROM damage_outer ORDER BY k;
                    QUERY PLAN                    
--------------------------------------------------
 Custom Scan (TessSort)
   Sort Key: k
   ->  Custom Scan (TessHeapScan) on damage_outer
(3 rows)

SELECT damaged(:'damage_module', NULL, 0, $$SELECT k, t FROM damage_outer ORDER BY k$$);
 damaged  
----------
 no error
(1 row)

SELECT damaged(:'damage_module', 'kind', 1, $$SELECT k, t FROM damage_outer ORDER BY k$$);
                                damaged                                
-----------------------------------------------------------------------
 XX001: a spilled block of kind 1 where its pair has a block of kind 3
(1 row)

SELECT damaged(:'damage_module', 'number', 1, $$SELECT k, t FROM damage_outer ORDER BY k$$);
                                 damaged                                 
-------------------------------------------------------------------------
 XX001: a spilled block numbered 1073741824 where its pair is numbered 0
(1 row)

-- The blocks of values and of rows of a run's first block numbered as
-- its second: each is checked against the block read, not only against
-- the blocks of the run.
SELECT damaged(:'damage_module', 'next', 1, $$SELECT k, t FROM damage_outer ORDER BY k$$);
                            damaged                             
----------------------------------------------------------------
 XX001: a spilled block numbered 1 where its pair is numbered 0
(1 row)

SELECT damaged(:'damage_module', 'next', 2, $$SELECT k, t FROM damage_outer ORDER BY k$$);
