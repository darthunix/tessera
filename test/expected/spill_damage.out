-- The grouping, by hash: rows on disk, for an aggregate it has no
-- states of its own for.
SET enable_sort = off;
EXPLAIN (COSTS OFF) SELECT count(*), max(m) FROM (SELECT k, max(t) AS m FROM damage_outer GROUP BY k) AS q;
                             QUERY PLAN                             
--------------------------------------------------------------------
 Custom Scan (TessAgg)
   ->  Custom Scan (TessPack)
         ->  Subquery Scan on q
               ->  Custom Scan (TessAgg)
                     Group Key: damage_outer.k
                     ->  Custom Scan (TessHeapScan) on damage_outer
(6 rows)

SELECT damaged(:'damage_module', NULL, 0, $$SELECT count(*), max(m) FROM (SELECT k, max(t) AS m FROM damage_outer GROUP BY k) AS q$$);
