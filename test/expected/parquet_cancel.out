-- What a Parquet table's scans do at injection points: a query that
-- reads a group of a million rows is cancelled when it has read the
-- group's first window, and stops within the group; and a file replaced
-- before a worker of a parallel plan opens it. This suite runs only on a
-- build with injection points; on another it ends here.
\getenv libdir PG_LIBDIR
\getenv dlsuffix PG_DLSUFFIX
\set parquet_test :libdir '/tessera_parquet_test' :dlsuffix
\set parquet_module :libdir '/tessera_parquet_test'
CREATE FUNCTION parquet_test_injection() RETURNS boolean
    AS :'parquet_test', 'tessera_parquet_test_injection' LANGUAGE C STRICT;
SELECT NOT parquet_test_injection() AS skip \gset
\if :skip
DROP FUNCTION parquet_test_injection();
\quit
\endif
CREATE EXTENSION tessera;
LOAD 'tessera_nodes';
LOAD 'tessera_kernels';
CREATE EXTENSION tessera_parquet;
CREATE FUNCTION parquet_test_write(text, text) RETURNS void
    AS :'parquet_test', 'tessera_parquet_test_write' LANGUAGE C STRICT;
CREATE FUNCTION parquet_test_cancel_after(text, int) RETURNS void
    AS :'parquet_test', 'tessera_parquet_test_cancel_after' LANGUAGE C;
CREATE FUNCTION parquet_test_windows() RETURNS int
    AS :'parquet_test', 'tessera_parquet_test_windows' LANGUAGE C STRICT;
\getenv abs_builddir PG_ABS_BUILDDIR
\set million :abs_builddir '/results/parquet_files/million.parquet'
SELECT parquet_test_write(:'million',
    '{"group_rows": 1000000, "columns": [{"name": "i", "type": "int64", "range": 1000000}]}');
 parquet_test_write 
--------------------
 
(1 row)

CREATE SERVER pq FOREIGN DATA WRAPPER tessera_parquet;
CREATE FOREIGN TABLE t_million (i bigint) SERVER pq OPTIONS (files :'million');
-- spec: parquet-fdw/A cancel within a group of rows
-- The group holds 977 windows of 1024 rows; the query stops, 57014,
-- having read fewer. Once with Tessera off and once with it on.
SET tessera.enable = off;
EXPLAIN (COSTS OFF) SELECT sum(i) FROM t_million;
           QUERY PLAN            
---------------------------------
 Aggregate
   ->  Foreign Scan on t_million
         Parquet Files: 1
         Row Groups: 1
(4 rows)

SELECT parquet_test_cancel_after(:'parquet_module', 1);
 parquet_test_cancel_after 
---------------------------
 
(1 row)

\set VERBOSITY sqlstate
SELECT sum(i) FROM t_million;
ERROR:  57014
\set VERBOSITY default
SELECT parquet_test_windows() BETWEEN 1 AND 976 AS stopped_within_the_group;
 stopped_within_the_group 
--------------------------
 t
(1 row)

RESET tessera.enable;
EXPLAIN (COSTS OFF) SELECT sum(i) FROM t_million;
                    QUERY PLAN                    
--------------------------------------------------
 Custom Scan (TessAgg)
   ->  Custom Scan (TessParquetScan) on t_million
         Parquet Files: 1
         Row Groups: 1
(4 rows)

SELECT parquet_test_cancel_after(:'parquet_module', 1);
 parquet_test_cancel_after 
---------------------------
 
(1 row)

\set VERBOSITY sqlstate
SELECT sum(i) FROM t_million;
ERROR:  57014
\set VERBOSITY default
SELECT parquet_test_windows() BETWEEN 1 AND 976 AS stopped_within_the_group;
 stopped_within_the_group 
--------------------------
 t
(1 row)

SELECT parquet_test_cancel_after(:'parquet_module', NULL);
 parquet_test_cancel_after 
---------------------------
 
(1 row)

-- Without the cancel, every window.
SELECT sum(i) = 999999::numeric * 1000000 / 2 AS every_row FROM t_million;
 every_row 
-----------
 t
(1 row)

-- The windows a scan reads, counted at the same injection point, with a
-- cancel that never comes: a group of three windows whose middle one
-- holds no row the clause passes. The node reads a's three windows, and
-- b's first and last, each once, forward: the last is read forward after
-- the gap, not again for each of its batches.
\set gap :abs_builddir '/results/parquet_files/gap.parquet'
SELECT parquet_test_write(:'gap', '{"group_rows": 3072, "columns": [
    {"name": "a", "type": "int64", "values": ' ||
    (SELECT json_agg(CASE WHEN g / 1024 = 1 THEN 0 ELSE 1 END) FROM generate_series(0, 3071) g) ||
    '}, {"name": "b", "type": "int64", "range": 3072}]}');
 parquet_test_write 
--------------------
 
(1 row)

CREATE FOREIGN TABLE t_gap (a bigint, b bigint) SERVER pq OPTIONS (files :'gap');
EXPLAIN (COSTS OFF) SELECT sum(b) FROM t_gap WHERE a <> 0;
                     QUERY PLAN                     
----------------------------------------------------
 Custom Scan (TessAgg)
   ->  Custom Scan (TessFilter) on t_gap
         Batch Filter: (a <> 0)
         ->  Custom Scan (TessParquetScan) on t_gap
               Parquet Files: 1
               Row Groups: 1
(6 rows)

SELECT parquet_test_cancel_after(:'parquet_module', 1000000);
 parquet_test_cancel_after 
---------------------------
 
(1 row)

SELECT sum(b) = 3071 * 3072 / 2 - (1024 + 2047) * 1024 / 2 AS passed_rows FROM t_gap WHERE a <> 0;
 passed_rows 
-------------
 t
(1 row)

SELECT parquet_test_windows() AS windows_read;
 windows_read 
--------------
            5
(1 row)

SELECT parquet_test_cancel_after(:'parquet_module', NULL);
 parquet_test_cancel_after 
---------------------------
 
(1 row)

-- spec: parquet-fdw/A file replaced between participants
-- A parallel plan whose leader has begun its scan, the file replaced by
-- a rename with one of its bytes and time before a worker opens it,
-- through an injection point before each file a worker opens: the worker
-- raises 55000. Once with Tessera off and once with it on.
CREATE FUNCTION parquet_test_replace_in_worker(text, bool) RETURNS void
    AS :'parquet_test', 'tessera_parquet_test_replace_in_worker' LANGUAGE C STRICT;
\set eight :abs_builddir '/results/parquet_files/eight_cancel.parquet'
SELECT parquet_test_write(:'eight',
    '{"group_rows": 1000, "columns": [{"name": "i", "type": "int64", "range": 8000}]}');
 parquet_test_write 
--------------------
 
(1 row)

CREATE FOREIGN TABLE t_eight (i bigint) SERVER pq OPTIONS (files :'eight');
SET max_parallel_workers_per_gather = 2;
SET min_parallel_table_scan_size = 0;
SET parallel_setup_cost = 0;
SET parallel_tuple_cost = 0;
SET parallel_leader_participation = off;
SELECT parquet_test_replace_in_worker(:'parquet_module', true);
 parquet_test_replace_in_worker 
--------------------------------
 
(1 row)

SET tessera.enable = off;
\set VERBOSITY sqlstate
SELECT sum(i) FROM t_eight;
ERROR:  55000
\set VERBOSITY default
RESET tessera.enable;
\set VERBOSITY sqlstate
SELECT sum(i) FROM t_eight;
ERROR:  55000
\set VERBOSITY default
SELECT parquet_test_replace_in_worker(:'parquet_module', false);
 parquet_test_replace_in_worker 
--------------------------------
 
(1 row)

SELECT sum(i) FROM t_eight;
   sum    
----------
 31996000
(1 row)

RESET max_parallel_workers_per_gather;
RESET min_parallel_table_scan_size;
RESET parallel_setup_cost;
RESET parallel_tuple_cost;
RESET parallel_leader_participation;
DROP FOREIGN TABLE t_million, t_eight, t_gap;
DROP SERVER pq;
DROP FUNCTION parquet_test_injection(), parquet_test_write(text, text),
    parquet_test_cancel_after(text, int), parquet_test_windows(),
    parquet_test_replace_in_worker(text, bool);
DROP EXTENSION tessera_parquet;
DROP EXTENSION tessera;
