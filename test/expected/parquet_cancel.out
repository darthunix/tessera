-- What a Parquet table's scans do at injection points: a query that
-- reads a group of a million rows is cancelled when it has read the
-- group's first window, and stops within the group; and a file replaced
-- before a worker of a parallel plan opens it. This suite runs only on a
-- build with injection points; on another it ends here.
\getenv libdir PG_LIBDIR
\getenv dlsuffix PG_DLSUFFIX
\set parquet_test :libdir '/tessera_parquet_test' :dlsuffix
\set parquet_module :libdir '/tessera_parquet_test'
CREATE FUNCTION parquet_test_injection() RETURNS boolean
    AS :'parquet_test', 'tessera_parquet_test_injection' LANGUAGE C STRICT;
SELECT NOT parquet_test_injection() AS skip \gset
\if :skip
DROP FUNCTION parquet_test_injection();
\quit
\endif
CREATE EXTENSION tessera;
LOAD 'tessera_nodes';
LOAD 'tessera_kernels';
CREATE EXTENSION tessera_parquet;
CREATE FUNCTION parquet_test_write(text, text) RETURNS void
    AS :'parquet_test', 'tessera_parquet_test_write' LANGUAGE C STRICT;
CREATE FUNCTION parquet_test_cancel_after(text, int) RETURNS void
    AS :'parquet_test', 'tessera_parquet_test_cancel_after' LANGUAGE C;
CREATE FUNCTION parquet_test_windows() RETURNS int
    AS :'parquet_test', 'tessera_parquet_test_windows' LANGUAGE C STRICT;
\getenv abs_builddir PG_ABS_BUILDDIR
\set million :abs_builddir '/results/parquet_files/million.parquet'
SELECT parquet_test_write(:'million',
    '{"group_rows": 1000000, "columns": [{"name": "i", "type": "int64", "range": 1000000}]}');
 parquet_test_write 
--------------------
 
(1 row)

CREATE SERVER pq FOREIGN DATA WRAPPER tessera_parquet;
CREATE FOREIGN TABLE t_million (i bigint) SERVER pq OPTIONS (files :'million');
-- spec: parquet-fdw/A cancel within a group of rows
-- The group holds 977 windows of 1024 rows; the query stops, 57014,
-- having read fewer. Once with Tessera off and once with it on.
SET tessera.enable = off;
EXPLAIN (COSTS OFF) SELECT sum(i) FROM t_million;
           QUERY PLAN            
---------------------------------
 Aggregate
   ->  Foreign Scan on t_million
         Parquet Files: 1
         Row Groups: 1
(4 rows)

SELECT parquet_test_cancel_after(:'parquet_module', 1);
 parquet_test_cancel_after 
---------------------------
 
(1 row)

\set VERBOSITY sqlstate
SELECT sum(i) FROM t_million;
ERROR:  57014
\set VERBOSITY default
SELECT parquet_test_windows() BETWEEN 1 AND 976 AS stopped_within_the_group;
 stopped_within_the_group 
--------------------------
 t
(1 row)

RESET tessera.enable;
EXPLAIN (COSTS OFF) SELECT sum(i) FROM t_million;
                    QUERY PLAN                    
--------------------------------------------------
 Custom Scan (TessAgg)
   ->  Custom Scan (TessParquetScan) on t_million
         Parquet Files: 1
         Row Groups: 1
(4 rows)

SELECT parquet_test_cancel_after(:'parquet_module', 1);
 parquet_test_cancel_after 
---------------------------
 
(1 row)

\set VERBOSITY sqlstate
SELECT sum(i) FROM t_million;
ERROR:  57014
\set VERBOSITY default
SELECT parquet_test_windows() BETWEEN 1 AND 976 AS stopped_within_the_group;
 stopped_within_the_group 
--------------------------
 t
(1 row)

-- Under a clause the source checks whose only row is the last, which the
-- footer cannot rule out, the cancel comes in the pass over the clause's
-- column, before the group is selected.
EXPLAIN (COSTS OFF) SELECT count(*) FROM t_million WHERE i > 999998;
                    QUERY PLAN                    
--------------------------------------------------
 Custom Scan (TessAgg)
   ->  Custom Scan (TessParquetScan) on t_million
         Source Exact: (i > 999998)
         Parquet Files: 1
         Row Groups: 1
(5 rows)

SELECT parquet_test_cancel_after(:'parquet_module', 1);
 parquet_test_cancel_after 
---------------------------
 
(1 row)

\set VERBOSITY sqlstate
SELECT count(*) FROM t_million WHERE i > 999998;
ERROR:  57014
\set VERBOSITY default
SELECT parquet_test_windows() BETWEEN 1 AND 976 AS stopped_within_the_pass;
 stopped_within_the_pass 
-------------------------
 t
(1 row)

SELECT parquet_test_cancel_after(:'parquet_module', NULL);
 parquet_test_cancel_after 
---------------------------
 
(1 row)

-- Without the cancel, every window.
SELECT sum(i) = 999999::numeric * 1000000 / 2 AS every_row FROM t_million;
 every_row 
-----------
 t
(1 row)

-- The windows a scan reads, counted at the same injection point, with a
-- cancel that never comes: a group of three windows whose middle one
-- holds no row TessFilter's clause passes. The node reads a's three
-- windows, and b's first and last, each once, forward: the last is read
-- forward after the gap, not again for each of its batches. Where the
-- source checks the clause itself, its pass reads a's three windows and
-- then b's two.
\set gap :abs_builddir '/results/parquet_files/gap.parquet'
SELECT parquet_test_write(:'gap', '{"group_rows": 3072, "columns": [
    {"name": "a", "type": "int64", "values": ' ||
    (SELECT json_agg(CASE WHEN g / 1024 = 1 THEN 0 ELSE 1 END) FROM generate_series(0, 3071) g) ||
    '}, {"name": "b", "type": "int64", "range": 3072}]}');
 parquet_test_write 
--------------------
 
(1 row)

CREATE FOREIGN TABLE t_gap (a bigint, b bigint) SERVER pq OPTIONS (files :'gap');
EXPLAIN (COSTS OFF) SELECT sum(b) FROM t_gap WHERE a + 0 <> 0;
                     QUERY PLAN                     
----------------------------------------------------
 Custom Scan (TessAgg)
   ->  Custom Scan (TessFilter) on t_gap
         Batch Filter: ((a + 0) <> 0)
         ->  Custom Scan (TessParquetScan) on t_gap
               Parquet Files: 1
               Row Groups: 1
(6 rows)

SELECT parquet_test_cancel_after(:'parquet_module', 1000000);
 parquet_test_cancel_after 
---------------------------
 
(1 row)

SELECT sum(b) = 3071 * 3072 / 2 - (1024 + 2047) * 1024 / 2 AS passed_rows
FROM t_gap WHERE a + 0 <> 0;
 passed_rows 
-------------
 t
(1 row)

SELECT parquet_test_windows() AS windows_read;
 windows_read 
--------------
            5
(1 row)

SELECT parquet_test_cancel_after(:'parquet_module', 1000000);
 parquet_test_cancel_after 
---------------------------
 
(1 row)

SELECT sum(b) = 3071 * 3072 / 2 - (1024 + 2047) * 1024 / 2 AS passed_rows FROM t_gap WHERE a <> 0;
 passed_rows 
-------------
 t
(1 row)

SELECT parquet_test_windows() AS windows_read_under_the_source;
 windows_read_under_the_source 
-------------------------------
                             5
(1 row)

SELECT parquet_test_cancel_after(:'parquet_module', NULL);
 parquet_test_cancel_after 
---------------------------
 
(1 row)

-- spec: parquet-fdw/A file replaced between participants
-- A parallel plan whose leader has begun its scan, the file replaced by
-- a rename with one of its bytes and time before a worker opens it,
-- through an injection point before each file a worker opens: the worker
-- raises 55000. Once with Tessera off and once with it on.
CREATE FUNCTION parquet_test_replace_in_worker(text, bool) RETURNS void
    AS :'parquet_test', 'tessera_parquet_test_replace_in_worker' LANGUAGE C STRICT;
\set eight :abs_builddir '/results/parquet_files/eight_cancel.parquet'
SELECT parquet_test_write(:'eight',
    '{"group_rows": 1000, "columns": [{"name": "i", "type": "int64", "range": 8000}]}');
 parquet_test_write 
--------------------
 
(1 row)

CREATE FOREIGN TABLE t_eight (i bigint) SERVER pq OPTIONS (files :'eight');
SET max_parallel_workers_per_gather = 2;
SET min_parallel_table_scan_size = 0;
SET parallel_setup_cost = 0;
SET parallel_tuple_cost = 0;
SET parallel_leader_participation = off;
SELECT parquet_test_replace_in_worker(:'parquet_module', true);
 parquet_test_replace_in_worker 
--------------------------------
 
(1 row)

SET tessera.enable = off;
\set VERBOSITY sqlstate
SELECT sum(i) FROM t_eight;
ERROR:  55000
\set VERBOSITY default
RESET tessera.enable;
\set VERBOSITY sqlstate
SELECT sum(i) FROM t_eight;
ERROR:  55000
\set VERBOSITY default
SELECT parquet_test_replace_in_worker(:'parquet_module', false);
 parquet_test_replace_in_worker 
--------------------------------
 
(1 row)

SELECT sum(i) FROM t_eight;
   sum    
----------
 31996000
(1 row)

RESET max_parallel_workers_per_gather;
RESET min_parallel_table_scan_size;
RESET parallel_setup_cost;
RESET parallel_tuple_cost;
RESET parallel_leader_participation;
-- contract: string-bytes/bytes past a batch
-- The references that keep a batch's bytes where they are. With each
-- ask made to read the batch's window again, behind the reader, and the
-- column asked as Datum values before its first ask in the bytes form,
-- so that this ask's window is a read behind too, whose arrays the later
-- asks replace, the test module reads the first ask's bytes again after
-- the later asks, in C, so that ASan sees a buffer freed early, and the
-- reader keeps no other reference to them; every row is its value's, and
-- the two asks of a column through a dictionary name two dictionaries,
-- so that the second gives no indexes. The module fails where no
-- reference lives while the batch does, or one is left after a rescan
-- or the scan's end; an error raised right after a reference is taken
-- leaves none either.
CREATE FUNCTION parquet_test_bytes(text, int, int, bigint, bool, bool, bool DEFAULT false)
    RETURNS TABLE (col text, n int, ask text, bytes bytea, ind int, dict bool)
    AS :'parquet_test', 'tessera_parquet_test_bytes' LANGUAGE C STRICT;
CREATE FUNCTION parquet_test_holds() RETURNS bigint
    AS :'parquet_test', 'tessera_parquet_test_holds' LANGUAGE C STRICT;
CREATE FUNCTION parquet_test_point(text, text, bool) RETURNS void
    AS :'parquet_test', 'tessera_parquet_test_point' LANGUAGE C STRICT;
\set held :abs_builddir '/results/parquet_files/held_'
SELECT parquet_test_write(:'held' || f || '.parquet', json_build_object(
    'dictionary', f = 'dict', 'columns', json_build_array(
      json_build_object('name', 's', 'type', 'bytes', 'logical', 'string', 'values',
        (SELECT json_agg(CASE WHEN n % 6 = 1 THEN NULL ELSE repeat('é', n % 9) || n % 11 END
                         ORDER BY n)
         FROM generate_series(0, 99) n))))::text)
FROM (VALUES ('plain'), ('dict')) t(f);
 parquet_test_write 
--------------------
 
 
(2 rows)

\set held_plain :held 'plain.parquet'
\set held_dict :held 'dict.parquet'
CREATE FOREIGN TABLE t_held_plain (s text) SERVER pq OPTIONS (files :'held_plain');
CREATE FOREIGN TABLE t_held_dict (s text) SERVER pq OPTIONS (files :'held_dict');
CREATE TABLE h_held AS
SELECT n, CASE WHEN n % 6 = 1 THEN NULL ELSE repeat('é', n % 9) || n % 11 END AS s
FROM generate_series(0, 99) n;
SELECT parquet_test_point(:'parquet_module', 'tessera-parquet-again', true);
 parquet_test_point 
--------------------
 
(1 row)

SELECT tbl, max_rows, ask, count(*) AS asked, bool_or(dict) AS dict,
       count(*) FILTER (WHERE bytes IS DISTINCT FROM convert_to(h.s, 'UTF8')) AS differ
FROM (VALUES ('t_held_plain'), ('t_held_dict')) t(tbl),
     (VALUES (64, 0), (10, 6)) b(max_rows, skip),
     parquet_test_bytes(format('SELECT s FROM %s', tbl), max_rows, skip,
                        x'5555555555555555'::bigint, true, true) p
     JOIN h_held h ON h.n = p.n
GROUP BY tbl, max_rows, ask ORDER BY tbl, max_rows, ask;
     tbl      | max_rows |    ask    | asked | dict | differ 
--------------+----------+-----------+-------+------+--------
 t_held_dict  |       10 | first     |     5 | t    |      0
 t_held_dict  |       10 | kept      |     5 | t    |      0
 t_held_dict  |       10 | rescanned |     5 | t    |      0
 t_held_dict  |       10 | rest      |     5 | f    |      0
 t_held_dict  |       64 | first     |    32 | t    |      0
 t_held_dict  |       64 | kept      |    32 | t    |      0
 t_held_dict  |       64 | rescanned |    32 | t    |      0
 t_held_dict  |       64 | rest      |    32 | f    |      0
 t_held_plain |       10 | first     |     5 | f    |      0
 t_held_plain |       10 | kept      |     5 | f    |      0
 t_held_plain |       10 | rescanned |     5 | f    |      0
 t_held_plain |       10 | rest      |     5 | f    |      0
 t_held_plain |       64 | first     |    32 | f    |      0
 t_held_plain |       64 | kept      |    32 | f    |      0
 t_held_plain |       64 | rescanned |    32 | f    |      0
 t_held_plain |       64 | rest      |    32 | f    |      0
(16 rows)

-- The same in batches of ten, the six before the one checked, and those
-- after the rescan, asked first for every row in the bytes form.
SELECT tbl, ask, count(*) AS asked,
       count(*) FILTER (WHERE bytes IS DISTINCT FROM convert_to(h.s, 'UTF8')) AS differ
FROM (VALUES ('t_held_plain'), ('t_held_dict')) t(tbl),
     parquet_test_bytes(format('SELECT s FROM %s', tbl), 10, 6,
                        x'5555555555555555'::bigint, true, true, true) p
     JOIN h_held h ON h.n = p.n
GROUP BY tbl, ask ORDER BY tbl, ask;
     tbl      |    ask    | asked | differ 
--------------+-----------+-------+--------
 t_held_dict  | first     |     5 |      0
 t_held_dict  | kept      |     5 |      0
 t_held_dict  | rescanned |     5 |      0
 t_held_dict  | rest      |     5 |      0
 t_held_plain | first     |     5 |      0
 t_held_plain | kept      |     5 |      0
 t_held_plain | rescanned |     5 |      0
 t_held_plain | rest      |     5 |      0
(8 rows)

-- spec: string-bytes/A dictionary given again
-- A grouping over windows read again at each ask, over two chunks of 1100
-- rows whose dictionaries give one index to two values: in each chunk the
-- first batch reads the window of 1024 rows forward, every later batch of
-- it reads it behind, decoding the chunk's dictionary anew under a new
-- identity, and the first batch of the rows past it reads forward again.
-- The key's numbers of the indexes are dropped at each new identity; the
-- heap's groups. Kept across the second chunk, the first's numbers would
-- be taken for its values.
SELECT parquet_test_write(:'held' || 'two.parquet', json_build_object(
    'group_rows', 1100, 'dictionary', true, 'columns', json_build_array(
      json_build_object('name', 's', 'type', 'bytes', 'logical', 'string', 'values',
        (SELECT json_agg(CASE WHEN n % 6 = 1 THEN NULL ELSE repeat('é', n % 9) || n % 11 END
                         ORDER BY n)
         FROM generate_series(0, 2199) n))))::text);
 parquet_test_write 
--------------------
 
(1 row)

\set held_two :held 'two.parquet'
CREATE FOREIGN TABLE t_held_two (s text) SERVER pq OPTIONS (files :'held_two');
CREATE TABLE h_held_two AS
SELECT CASE WHEN n % 6 = 1 THEN NULL ELSE repeat('é', n % 9) || n % 11 END AS s
FROM generate_series(0, 2199) n;
SELECT (SELECT array_agg(x ORDER BY x) FROM
          (SELECT s || ':' || count(*) AS x FROM t_held_two GROUP BY s) a) IS NOT DISTINCT FROM
       (SELECT array_agg(x ORDER BY x) FROM
          (SELECT s || ':' || count(*) AS x FROM h_held_two GROUP BY s) b) AS same_groups;
 same_groups 
-------------
 t
(1 row)

DROP FOREIGN TABLE t_held_two;
DROP TABLE h_held_two;
SELECT parquet_test_point(:'parquet_module', 'tessera-parquet-again', false);
 parquet_test_point 
--------------------
 
(1 row)

SELECT parquet_test_holds() AS holds \gset
SELECT parquet_test_point(:'parquet_module', 'tessera-parquet-bytes', true);
 parquet_test_point 
--------------------
 
(1 row)

SELECT count(*) FROM parquet_test_bytes('SELECT s FROM t_held_dict', 64, 0, 1, false, false);
ERROR:  an error injected after a reference to a window was taken
SELECT parquet_test_point(:'parquet_module', 'tessera-parquet-bytes', false);
 parquet_test_point 
--------------------
 
(1 row)

SELECT parquet_test_holds() - :holds AS left_after_the_error;
 left_after_the_error 
----------------------
                    0
(1 row)

DROP FOREIGN TABLE t_million, t_eight, t_gap, t_held_plain, t_held_dict;
DROP TABLE h_held;
DROP SERVER pq;
DROP FUNCTION parquet_test_injection(), parquet_test_write(text, text),
    parquet_test_cancel_after(text, int), parquet_test_windows(),
    parquet_test_replace_in_worker(text, bool),
    parquet_test_bytes(text, int, int, bigint, bool, bool, bool), parquet_test_holds(),
    parquet_test_point(text, text, bool);
DROP EXTENSION tessera_parquet;
DROP EXTENSION tessera;
