-----------------------------------------------------------------------------------------------------------------
 Custom Scan (TessAgg)
   Output: unnamed_subquery.c, unnamed_subquery.b
   Group Key: unnamed_subquery.c, unnamed_subquery.b
   ->  Custom Scan (TessGather)
         Output: unnamed_subquery.c, unnamed_subquery.b
         Workers Planned: 2
         ->  Parallel Custom Scan (TessSend)
               Output: unnamed_subquery.c, unnamed_subquery.b
               ->  Parallel Custom Scan (TessAgg)
                     Output: unnamed_subquery.c, unnamed_subquery.b
                     Group Key: unnamed_subquery.c, unnamed_subquery.b
                     Partial Mode: Partial
                     ->  Parallel Custom Scan (TessAppend)
                           Output: unnamed_subquery.c, unnamed_subquery.b
                           ->  Custom Scan (TessPack)
                                 Output: unnamed_subquery.c, unnamed_subquery.b
                                 Rows Kept As: forwarded batches
                                 ->  Parallel Custom Scan (TessFilter) on public.union_keys
                                       Output: union_keys.c, union_keys.b
                                       Batch Filter: (union_keys.b < 5)
